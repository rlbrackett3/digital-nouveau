---
// Header matching Wix structure exactly
import { SITE_TITLE, TAGLINES } from '../consts';
---

<header class="site-header">
  <div class="container">
    <div class="header-content">
      <div class="header-left">
        <h1 class="site-title">
          <a href="/">{SITE_TITLE}</a>
        </h1>
        <div class="taglines">
          {TAGLINES.map(line => (
            <p class="tagline">{line}</p>
          ))}
        </div>
      </div>
      
      <div class="header-right">
        <nav class="utility-nav">
          <a href="/feed" class="nav-link">feed</a>
          <a href="/portfolio" class="nav-link">portfolio</a>
          <a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
        </nav>
      </div>
    </div>
    
    <nav class="main-nav">
      <a href="/" class="nav-link">everything ~</a>
      <a href="/category/design" class="nav-link">design</a>
      <a href="/category/drawings" class="nav-link">drawings</a>
      <a href="/category/readings" class="nav-link">readings</a>
      <a href="/category/skyfi" class="nav-link">skyfi</a>
      <a href="/category/thinkings" class="nav-link">thinkings</a>
      <a href="/category/observings" class="nav-link">observings</a>
      <a href="/category/teachings" class="nav-link">teachings</a>
      <a href="/category/writings" class="nav-link">writings</a>
    </nav>
  </div>
</header>

<style>
.site-header {
  padding: 40px 0 20px;
  position: relative;
  z-index: 10;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.header-left {
  max-width: 400px;
}

.site-title {
  font-size: 28px;
  font-weight: 400;
  margin: 0 0 8px;
  line-height: 1.2;
}

.site-title a {
  color: #1ceb f4;
  text-decoration: none;
}

.tagline {
  font-size: 12px;
  color: #1ceb f4;
  margin: 2px 0;
  opacity: 0.7;
  font-family: "Brandon Grotesque", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.utility-nav {
  display: flex;
  gap: 24px;
}

.main-nav {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  padding-top: 16px;
  border-top: 1px solid rgba(28, 235, 244, 0.2);
}

.nav-link {
  color: #1ceb f4;
  text-decoration: none;
  font-size: 14px;
  font-family: "Brandon Grotesque", "Helvetica Neue", Helvetica, Arial, sans-serif;
  transition: opacity 0.2s;
}

.nav-link:hover {
  opacity: 0.7;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    gap: 20px;
  }
  
  .header-left {
    max-width: 100%;
  }
  
  .main-nav {
    gap: 16px;
  }
}
</style>
