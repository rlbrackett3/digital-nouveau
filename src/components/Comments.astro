---
// Comments via giscus — real backend: GitHub Discussions.
// One Discussion per post, keyed to pathname. No server, no tracking, data owned by repo.
// Leave ENABLED false until the giscus GitHub App is installed on the repo:
// https://github.com/apps/giscus -> Install -> select ONLY digital-nouveau
const ENABLED = true;

const GISCUS = {
	repo: 'rlbrackett3/digital-nouveau',
	repoId: 'R_kgDOVzFs8g',
	category: 'General',
	categoryId: 'DIC_kwDOVzFs8s4DLa9l',
};

const enabled = ENABLED && Boolean(GISCUS.repoId && GISCUS.categoryId);
---

{enabled && (
	<div class="comments-section">
		<div class="comments-container">
			<h2 class="comments-title">&gt; comments</h2>
			<div class="comments-divider"></div>
			<div
				id="giscus-thread"
				class="giscus"
				data-repo={GISCUS.repo}
				data-repo-id={GISCUS.repoId}
				data-category={GISCUS.category}
				data-category-id={GISCUS.categoryId}
				data-mapping="pathname"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme="transparent_dark"
				data-lang="en"
				loading="lazy"
			></div>
		</div>
	</div>
)}

<style is:global>
	.comments-section {
		margin-bottom: 48px;
	}

	.comments-container {
		border: 1px solid var(--accent);
		padding: 24px;
		display: flex;
		flex-direction: column;
		background: transparent;
	}

	@media (max-width: 768px) {
		.comments-container {
			padding: 16px;
		}
	}

	.comments-title {
		font-size: 12px;
		font-family: var(--font-body);
		font-weight: var(--font-weight-body);
		color: var(--accent);
		margin: 0;
		opacity: 0.8;
		letter-spacing: 0.05em;
	}

	.comments-divider {
		height: 1px;
		background: rgba(28, 235, 244, 0.2);
		margin: 12px 0 20px;
		flex-shrink: 0;
	}

	/* giscus iframe inherits the site's dark/cyan surface */
	.giscus {
		min-height: 120px;
	}

	.giscus > iframe {
		color-scheme: dark;
	}
</style>

{enabled && (
	<script is:inline src="https://giscus.app/client.js" data-repo={GISCUS.repo} data-repo-id={GISCUS.repoId} data-category={GISCUS.category} data-category-id={GISCUS.categoryId} data-mapping="pathname" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme="transparent_dark" data-lang="en" crossorigin="anonymous" async></script>
)}
