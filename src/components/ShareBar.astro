---
// ShareBar — social sharing icons + post stats
import type { CollectionEntry } from 'astro:content';

const { title, slug, views, comments, likes } = Astro.props;
const url = `https://digital-nouveau.getforge.io/blog/${slug}/`;
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(url);

const socialLinks = [
  { label: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, icon: 'fab fa-facebook-f' },
  { label: 'X / Twitter', url: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`, icon: 'fab fa-x-twitter' },
  { label: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, icon: 'fab fa-linkedin-in' },
  { label: 'Copy Link', url: '#', icon: 'fas fa-link', action: 'copy' },
];
---

<div class="share-bar">
	<div class="share-icons">
		{socialLinks.map(link => (
			link.action === 'copy'
				? <a href={link.url} class="share-icon share-copy" data-url={shareUrl} aria-label={link.label} title={link.label}>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
					</a>
				: <a href={link.url} class="share-icon" target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
						{link.label === 'Facebook' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>}
						{link.label === 'X / Twitter' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
						{link.label === 'LinkedIn' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
					</a>
		))}
	</div>
	<div class="share-stats">
		{views !== undefined && <span class="stat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> {views} views</span>}
		{comments !== undefined && <span class="stat"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> {comments} comments</span>}
		{likes !== undefined && <span class="stat stat-likes"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> {likes}</span>}
	</div>
</div>

<style is:global>
	.share-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 20px 0;
		border-top: 1px solid rgba(28, 235, 244, 0.15);
		border-bottom: 1px solid rgba(28, 235, 244, 0.15);
		margin-bottom: 48px;
	}

	.share-icons {
		display: flex;
		gap: 16px;
	}

	.share-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(28, 235, 244, 0.6);
		transition: color 0.2s;
		cursor: pointer;
	}

	.share-icon:hover {
		color: var(--accent);
	}

	.share-stats {
		display: flex;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		font-family: var(--font-body);
		color: rgba(28, 235, 244, 0.5);
		flex-wrap: wrap;
	}

	.stat {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.stat-likes svg {
		color: rgba(255, 64, 64, 0.8);
	}

	@media (max-width: 768px) {
		.share-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}
	}
	</style>

	<script is:inline>
	(function() {
		var copyLink = document.querySelector('.share-copy');
		if (!copyLink) return;
		copyLink.addEventListener('click', function(e) {
			e.preventDefault();
			var url = copyLink.getAttribute('data-url');
			function done(ok) {
				copyLink.style.color = ok ? 'var(--accent)' : '';
				copyLink.title = ok ? 'Copied' : 'Copy failed';
				setTimeout(function() { copyLink.style.color = ''; copyLink.title = 'Copy Link'; }, 1500);
			}
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(url).then(function(){ done(true); }, function(){ done(false); });
			} else {
				var ta = document.createElement('textarea');
				ta.value = url;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				var ok = false;
				try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
				document.body.removeChild(ta);
				done(ok);
			}
		});
	})();
	</script>
