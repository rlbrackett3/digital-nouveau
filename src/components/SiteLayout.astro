---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_COPYRIGHT } from '../consts';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<header class="site-header">
	<div class="header-banner">
		<div class="header-text">
			<h6 class="site-title"><a href="/">&gt; Digital Nouveau ~</a></h6>
			<p class="header-tagline"><a href="/">&gt; initiating drone connection ~</a></p>
			<p class="header-sub">&gt; design|computation |fabrication ::make things ~</p>
			<p class="header-sub">&gt; we came here to do something, so let's do something ~</p>
		</div>
		<div class="header-gif">
			<a href="/"><img src="/arnica_CB_sections_02.gif" alt="Digital Nouveau" /></a>
		</div>
	</div>
	<nav class="top-nav">
		<a href="/" class="nav-link">feed</a>
		<a href="/portfolio" class="nav-link">portfolio</a>
		<a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
	</nav>
</header>

<footer class="site-footer">
	<div class="footer-inner">
		<div class="newsletter">
			<h3>newsletter</h3>
			<form action="#" method="post">
				<input type="text" placeholder="name" aria-label="Name" />
				<input type="email" placeholder="e-mail" aria-label="Email" />
				<button type="submit">intiate drone connection~</button>
			</form>
		</div>
		<p class="copyright">{SITE_COPYRIGHT}</p>
	</div>
</footer>

<style>
	/* Header */
	.site-header {
		background: #ffffff;
		padding: 1rem 2rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 0;
	}

	.header-banner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.header-text {
		flex: 1;
	}

	.site-title {
		margin: 0 0 0.25rem 0;
		font-size: 1.75rem;
		font-weight: 400;
		color: var(--accent);
	}

	.site-title a {
		color: var(--accent);
		text-decoration: none;
	}

	.header-tagline {
		margin: 0 0 0.25rem 0;
		font-size: 0.875rem;
	}

	.header-tagline a {
		color: var(--accent);
		text-decoration: none;
	}

	.header-sub {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.header-gif {
		flex-shrink: 0;
		width: 200px;
	}

	.header-gif img {
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	/* Top navigation */
	.top-nav {
		max-width: 1200px;
		margin: 0.75rem auto 0;
		display: flex;
		gap: 2rem;
	}

	.nav-link {
		color: var(--text-primary);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 400;
		transition: color 0.2s;
	}

	.nav-link:hover {
		color: var(--accent);
	}

	.nav-link[aria-current="page"] {
		color: var(--accent);
	}

	/* Footer */
	.site-footer {
		background: #ffffff;
		border-top: 1px solid var(--border);
		padding: 3rem 2rem;
		margin-top: 4rem;
	}

	.footer-inner {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter h3 {
		font-size: 0.875rem;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		margin: 0 0 1rem 0;
		color: var(--text-secondary);
		font-weight: 400;
	}

	.newsletter form {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.newsletter input {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-primary);
		font-size: 0.875rem;
		font-family: var(--font-sans);
		outline: none;
		transition: border-color 0.2s;
	}

	.newsletter input:focus {
		border-color: var(--accent);
	}

	.newsletter button {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-primary);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		cursor: pointer;
		font-family: var(--font-sans);
		transition: all 0.2s;
	}

	.newsletter button:hover {
		background: #f0f0f0;
		border-color: var(--text-muted);
	}

	.copyright {
		margin-top: 2rem;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	@media (max-width: 768px) {
		.site-header {
			padding: 1rem;
		}

		.header-banner {
			flex-direction: column;
			gap: 1rem;
		}

		.header-gif {
			width: 120px;
		}

		.site-title {
			font-size: 1.35rem;
		}

		.top-nav {
			gap: 1rem;
			font-size: 0.8rem;
		}

		.site-footer {
			padding: 2rem 1rem;
		}
	}
</style>