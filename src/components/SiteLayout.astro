---
// SiteLayout - Master layout matching Wix blog.digitalnouveau.com structure
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="stylesheet" href="/global.css" />
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="header-text">
				<h6 class="site-title"><a href="/">Digital Nouveau ~</a></h6>
				<p class="header-tagline"><a href="/">initiating drone connection ~</a></p>
				<p class="header-tagline"><a href="/blog">blog ~</a></p>
				<p class="header-sub">design|computation |fabrication ::make things ~</p>
				<p class="header-sub">we came here to do something, so let's do something ~</p>
			</div>

			<nav class="top-nav" aria-label="Site">
				<a href="/" class="nav-link" aria-current="page">feed</a>
				<a href="https://www.digitalnouveau.com" target="_blank" rel="noopener noreferrer" class="nav-link">portfolio</a>
				<a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
			</nav>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="newsletter">
					<h3>&gt; follow along~</h3>
					<form action="#" method="post" class="newsletter-form">
						<input type="text" placeholder="name" aria-label="Name" />
						<input type="email" placeholder="e-mail" aria-label="Email" />
						<button type="submit">&gt;intiate drone connection~</button>
					</form>
				</div>
				<div class="footer-copyright">
					<p class="copyright-line">&gt; copyright Robert Lee Brackett 2025 |</p>
					<p class="copyright-line">all rights reserved |</p>
					<p class="copyright-line">new york / tokyo ~</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	.site-header {
		padding: 12px var(--padding-x);
	}

	.header-text {
		margin-bottom: 1rem;
	}

	.site-title {
		margin: 0 0 0.15rem 0;
		font-size: 1.75rem;
		font-weight: 400;
		color: var(--text);
		line-height: 1.1;
	}

	.site-title a {
		color: var(--text);
		text-decoration: none;
	}

	.site-title a:hover {
		color: var(--text);
	}

	.header-tagline {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--text);
		line-height: 1.1em;
	}

	.header-tagline a {
		color: var(--text);
		text-decoration: none;
	}

	.header-tagline a:hover {
		text-decoration: underline;
	}

	.header-sub {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--text);
		line-height: 1.1em;
	}

	.top-nav {
		display: flex;
		gap: 1.5rem;
	}

	.nav-link {
		color: var(--text);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 400;
		transition: color 0.2s;
	}

	.nav-link:hover {
		text-decoration: underline;
	}

	.site-footer {
		padding: 2rem var(--padding-x);
		margin-top: 3rem;
		border-top: 1px solid var(--border);
	}

	.footer-inner {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter {
		margin-bottom: 2rem;
	}

	.newsletter h3 {
		font-size: 0.875rem;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		margin: 0 0 1rem 0;
		color: var(--text-muted);
		font-weight: 400;
	}

	.newsletter-form {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.newsletter-form input {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		font-size: 0.875rem;
		font-family: var(--font);
		font-weight: 400;
		outline: none;
		transition: border-color 0.2s;
		min-width: 120px;
	}

	.newsletter-form input::placeholder {
		color: var(--text-muted);
	}

	.newsletter-form input:focus {
		border-color: var(--text);
	}

	.newsletter-form button {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		cursor: pointer;
		font-family: var(--font);
		font-weight: 400;
		transition: all 0.2s;
	}

	.newsletter-form button:hover {
		border-color: var(--text);
	}

	.footer-copyright {
		font-family: var(--font);
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.copyright-line {
		margin: 0;
	}

	@media (max-width: 768px) {
		.site-header {
			padding: 1rem var(--padding-x);
		}

		.site-title {
			font-size: 1.35rem;
		}

		.header-tagline,
		.header-sub {
			font-size: 0.75rem;
		}

		.newsletter-form {
			flex-direction: column;
		}

		.newsletter-form input {
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.site-title {
			font-size: 1.15rem;
		}
	}
</style>
