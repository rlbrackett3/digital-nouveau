---
// SiteLayout — Digital Nouveau Wix clone
// Matching dark theme + neural network background from screenshots
interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/global.css" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title ? `${title} | Digital Nouveau` : 'Digital Nouveau'}</title>
		{description && <meta name="description" content={description} />}
		<slot name="head" />
	</head>
	<body>
		<!-- Neural network background image -->
		<img 
			src="/neural-bg.png" 
			alt="" 
			class="bg-neural" 
			loading="eager" 
			decoding="async"
		/>
		
		<header class="site-header">
			<div class="container">
				<div class="header-content">
					<div class="header-left">
						<h1 class="site-title">
							<a href="/">Digital Nouveau ~</a>
						</h1>
						<div class="taglines">
							<p class="tagline">&gt; initiating drone connection ~</p>
							<p class="tagline">&gt; blog ~</p>
							<p class="tagline">&gt; design | computation | fabrication :: make things ~</p>
							<p class="tagline">&gt; we came here to do something, so let's do something ~</p>
						</div>
					</div>
					
					<div class="header-right">
						<nav class="utility-nav">
							<a href="/feed" class="nav-link">feed</a>
							<a href="/portfolio" class="nav-link">portfolio</a>
							<a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
						</nav>
					</div>
				</div>
				
				<nav class="main-nav">
					<a href="/" class="nav-link">&gt; everything ~</a>
					<a href="/category/design" class="nav-link">design</a>
					<a href="/category/drawings" class="nav-link">drawings</a>
					<a href="/category/readings" class="nav-link">readings</a>
					<a href="/category/skyfi" class="nav-link">skyfi</a>
					<a href="/category/thinkings" class="nav-link">thinkings</a>
					<a href="/category/observings" class="nav-link">observings</a>
					<a href="/category/teachings" class="nav-link">teachings</a>
					<a href="/category/writings" class="nav-link">writings</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="newsletter">
					<h3 class="newsletter-title">&gt; follow along</h3>
					<form class="newsletter-form" action="#" method="post">
						<input type="text" placeholder="name" aria-label="Name" />
						<input type="email" placeholder="e-mail" aria-label="Email" />
						<button type="submit">&gt; initiate drone connection</button>
					</form>
				</div>
				<div class="footer-copy">
					<p>&gt; copyright Robert Lee Brackett 2025 | all rights reserved | new york / tokyo</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	/* Background neural network image - subtle overlay */
	.bg-neural {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
		opacity: 0.15;
		pointer-events: none;
		filter: grayscale(100%) brightness(0.3);
	}
	
	/* Container */
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	
	/* Header */
	.site-header {
		padding: 40px 0 20px;
		position: relative;
		z-index: 10;
	}
	
	.header-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 20px;
	}
	
	.header-left {
		max-width: 400px;
	}
	
	.site-title {
		font-size: 28px;
		font-weight: 400;
		margin: 0 0 8px;
		line-height: 1.2;
	}
	
	.site-title a {
		color: #1ceb f4;
		text-decoration: none;
	}
	
	.tagline {
		font-size: 12px;
		color: #1ceb f4;
		margin: 2px 0;
		opacity: 0.7;
		font-family: "Brandon Grotesque", "Helvetica Neue", Helvetica, Arial, sans-serif;
	}
	
	.utility-nav {
		display: flex;
		gap: 24px;
	}
	
	.main-nav {
		display: flex;
		gap: 24px;
		flex-wrap: wrap;
		padding-top: 16px;
		border-top: 1px solid rgba(28, 235, 244, 0.2);
	}
	
	.nav-link {
		color: #1ceb f4;
		text-decoration: none;
		font-size: 14px;
		font-family: "Brandon Grotesque", "Helvetica Neue", Helvetica, Arial, sans-serif;
		transition: opacity 0.2s;
	}
	
	.nav-link:hover {
		opacity: 0.7;
	}
	
	/* Footer */
	.site-footer {
		padding: 60px 0;
		text-align: center;
		border-top: 1px solid rgba(28, 235, 244, 0.1);
		position: relative;
		z-index: 10;
	}
	
	.footer-inner {
		max-width: 600px;
		margin: 0 auto;
		padding: 0 20px;
	}
	
	.newsletter {
		margin-bottom: 24px;
	}
	
	.newsletter-title {
		font-size: 14px;
		color: #1ceb f4;
		margin-bottom: 16px;
		font-weight: 400;
		letter-spacing: 0.05em;
	}
	
	.newsletter-form {
		display: flex;
		gap: 8px;
		justify-content: center;
		flex-wrap: wrap;
	}
	
	.newsletter-form input {
		padding: 10px 14px;
		border: 1px solid rgba(28, 235, 244, 0.3);
		background: rgba(0, 0, 0, 0.9);
		color: #1ceb f4;
		font-size: 12px;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		outline: none;
		min-width: 160px;
	}
	
	.newsletter-form input::placeholder {
		color: rgba(28, 235, 244, 0.4);
	}
	
	.newsletter-form input:focus {
		border-color: #1ceb f4;
	}
	
	.newsletter-form button {
		padding: 10px 20px;
		border: 1px solid rgba(28, 235, 244, 0.3);
		background: rgba(0, 0, 0, 0.9);
		color: #1ceb f4;
		font-size: 12px;
		cursor: pointer;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		transition: all 0.2s;
		letter-spacing: 0.05em;
	}
	
	.newsletter-form button:hover {
		border-color: #1ceb f4;
		background: rgba(28, 235, 244, 0.1);
	}
	
	.footer-copy {
		font-size: 11px;
		color: rgba(28, 235, 244, 0.4);
		line-height: 1.5;
	}
	
	.footer-copy p {
		margin: 0;
	}
	
	@media (max-width: 768px) {
		.header-content {
			flex-direction: column;
			gap: 20px;
		}
		
		.header-left {
			max-width: 100%;
		}
		
		.main-nav {
			gap: 16px;
		}
	}
</style>
