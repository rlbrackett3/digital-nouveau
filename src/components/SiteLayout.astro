---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_COPYRIGHT } from '../consts';
---

<header>
	<div class="header-inner">
		<a href="/" class="logo">
			<span class="sr-only">{SITE_TITLE}</span>
		</a>
		<nav>
			<a href="/" class="nav-link">feed</a>
			<a href="/portfolio" class="nav-link">portfolio</a>
			<a href="/skyfi" class="nav-link">skyfi :: a reading list</a>
		</nav>
	</div>
</header>

<footer>
	<div class="footer-inner">
		<div class="newsletter">
			<h3>newsletter</h3>
			<form action="#" method="post">
				<input type="text" placeholder="name" aria-label="Name" />
				<input type="email" placeholder="e-mail" aria-label="Email" />
				<button type="submit">intiate drone connection~</button>
			</form>
		</div>
		<p class="copyright">{SITE_COPYRIGHT}</p>
	</div>
</footer>

<style>
	/* Header */
	header {
		padding: 1rem 2rem;
		background: #1a1a2e;
		color: #e0e0e0;
	}

	.header-inner {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.logo {
		display: block;
		width: 120px;
		height: 40px;
		background: url('/dn-logo.svg') center/contain no-repeat;
	}

	nav {
		display: flex;
		gap: 1.5rem;
	}

	.nav-link {
		color: #e0e0e0;
		text-decoration: none;
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: lowercase;
		transition: color 0.2s;
	}

	.nav-link:hover {
		color: #fff;
	}

	.nav-link[aria-current="page"] {
		color: #fff;
		text-decoration: underline;
	}

	/* Footer */
	footer {
		padding: 3rem 2rem;
		background: #1a1a2e;
		color: #e0e0e0;
		margin-top: 4rem;
	}

	.footer-inner {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter h3 {
		font-size: 0.875rem;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
	}

	.newsletter form {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.newsletter input {
		padding: 0.5rem 1rem;
		border: 1px solid #333;
		background: transparent;
		color: #e0e0e0;
		font-size: 0.875rem;
	}

	.newsletter button {
		padding: 0.5rem 1rem;
		border: 1px solid #555;
		background: transparent;
		color: #e0e0e0;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		cursor: pointer;
		transition: background 0.2s;
	}

	.newsletter button:hover {
		background: #333;
	}

	.copyright {
		margin-top: 2rem;
		font-size: 0.75rem;
		color: #888;
	}

	@media (max-width: 768px) {
		.header-inner {
			flex-direction: column;
			gap: 1rem;
		}

		nav {
			flex-wrap: wrap;
			justify-content: center;
		}
	}
</style>
