---
// SiteLayout - Wix clone
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="stylesheet" href="/global.css" />
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<h6 class="site-title"><a href="/">Digital Nouveau ~</a></h6>
				<p class="header-tagline"><a href="/">initiating drone connection ~</a></p>
				<p class="header-tagline"><a href="/blog">blog ~</a></p>
				<p class="header-sub">design|computation |fabrication ::make things ~</p>
				<p class="header-sub">we came here to do something, so let's do something ~</p>
			</div>

			<nav class="top-nav">
				<a href="/" class="nav-link">feed</a>
				<a href="https://www.digitalnouveau.com" target="_blank" rel="noopener noreferrer" class="nav-link">portfolio</a>
				<a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
			</nav>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="newsletter">
					<h3>&gt; follow along~</h3>
					<form action="#" method="post" class="newsletter-form">
						<input type="text" placeholder="name" aria-label="Name" />
						<input type="email" placeholder="e-mail" aria-label="Email" />
						<button type="submit">&gt;intiate drone connection~</button>
					</form>
				</div>
				<div class="footer-copyright">
					<p>&gt; copyright Robert Lee Brackett 2025 |</p>
					<p>all rights reserved |</p>
					<p>new york / tokyo ~</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	.site-header {
		padding: 20px 60px 0;
	}

	.header-inner {
		max-width: 940px;
		margin: 0 auto;
	}

	.site-title {
		margin: 0 0 0.15rem 0;
		font-size: 28px;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1;
	}

	.site-title a {
		color: var(--accent);
		text-decoration: none;
	}

	.header-tagline {
		margin: 0;
		font-size: 14px;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1em;
	}

	.header-tagline a {
		color: var(--accent);
		text-decoration: none;
	}

	.header-sub {
		margin: 0;
		font-size: 14px;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1em;
	}

	.top-nav {
		max-width: 940px;
		margin: 20px auto 0;
		padding: 0 60px;
		display: flex;
		gap: 30px;
	}

	.nav-link {
		color: var(--link);
		text-decoration: none;
		font-size: 14px;
		font-weight: 400;
	}

	.nav-link:hover {
		text-decoration: underline;
	}

	.site-footer {
		padding: 40px 60px;
		margin-top: 60px;
		border-top: 1px solid var(--border);
	}

	.footer-inner {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter {
		margin-bottom: 2rem;
	}

	.newsletter h3 {
		font-size: 14px;
		font-weight: 300;
		margin: 0 0 1rem 0;
		color: var(--text-muted);
	}

	.newsletter-form {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.newsletter-form input {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		font-size: 14px;
		font-family: var(--font);
		font-weight: 300;
		outline: none;
		transition: border-color 0.2s;
		min-width: 120px;
	}

	.newsletter-form input::placeholder {
		color: var(--text-muted);
	}

	.newsletter-form input:focus {
		border-color: var(--accent);
	}

	.newsletter-form button {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text);
		font-size: 12px;
		cursor: pointer;
		font-family: var(--font);
		font-weight: 300;
		transition: all 0.2s;
	}

	.newsletter-form button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.footer-copyright {
		font-size: 14px;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.footer-copyright p {
		margin: 0;
	}

	@media (max-width: 768px) {
		.site-header {
			padding: 15px 20px 0;
		}

		.site-title {
			font-size: 22px;
		}

		.header-tagline,
		.header-sub {
			font-size: 12px;
		}

		.top-nav {
			padding: 0 20px;
			gap: 15px;
		}

		.newsletter-form {
			flex-direction: column;
		}

		.newsletter-form input {
			width: 100%;
		}
	}
</style>
