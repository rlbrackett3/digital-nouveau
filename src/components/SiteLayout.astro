---
// SiteLayout - Master layout matching Wix blog.digitalnouveau.com structure
import { SITE_TITLE, SITE_DESCRIPTION, SITE_COPYRIGHT, CATEGORIES } from '../consts';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/gif" href="/arnica_CB_sections_02.gif" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="/global.css" />
		<slot name="head" />
	</head>
	<body>
		<!-- SITE HEADER - 3 column layout matching Wix -->
		<header class="site-header">
			<div class="header-banner">
				<!-- Column 1: Text block -->
				<div class="header-text">
					<h6 class="site-title"><a href="/">Digital Nouveau ~</a></h6>
					<p class="header-tagline"><a href="/">initiating drone connection ~</a></p>
					<p class="header-tagline"><a href="/blog">blog ~</a></p>
					<p class="header-sub">design|computation |fabrication ::make things ~</p>
					<p class="header-sub">we came here to do something, so let's do something ~</p>
				</div>

				<!-- Column 2: GIF logo -->
				<div class="header-gif">
					<a href="/"><img src="/arnica_CB_sections_02.gif" alt="Digital Nouveau" width="60" height="60" /></a>
				</div>

				<!-- Column 3: Social bar (Twitter/X) - desktop -->
				<div class="social-bar social-bar-desktop">
					<a href="https://twitter.com/rooksisfun" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</a>
				</div>
			</div>

			<!-- Social bar (Twitter/X) - mobile only -->
			<div class="social-bar social-bar-mobile">
				<a href="https://twitter.com/rooksisfun" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
				</a>
			</div>

			<!-- Top navigation - matching Wix dropdown menu -->
			<nav class="top-nav" aria-label="Site">
				<a href="/" class="nav-link" aria-current="page">feed</a>
				<a href="https://www.digitalnouveau.com" target="_blank" rel="noopener noreferrer" class="nav-link">portfolio</a>
				<a href="/skyfi-a-reading-list" class="nav-link">skyfi :: a reading list</a>
			</nav>
		</header>

		<!-- Main content slot -->
		<slot />

		<!-- FOOTER - matching Wix structure -->
		<footer class="site-footer">
			<div class="footer-inner">
				<!-- Newsletter signup - matching Wix footer form -->
				<div class="newsletter">
					<h3>&gt; follow along~</h3>
					<form action="#" method="post" class="newsletter-form">
						<input type="text" placeholder="name" aria-label="Name" />
						<input type="email" placeholder="e-mail" aria-label="Email" />
						<button type="submit">&gt;intiate drone connection~</button>
					</form>
				</div>
				<!-- Copyright - matching Wix monospace footer -->
				<div class="footer-copyright">
					<p class="copyright-line">&gt; copyright Robert Lee Brackett 2025 |</p>
					<p class="copyright-line">all rights reserved |</p>
					<p class="copyright-line">new york / tokyo ~</p>
				</div>
				<!-- Social link -->
				<div class="footer-social">
					<a href="https://twitter.com/rooksisfun" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
/* Header */
	.site-header {
		background: var(--bg-header);
		padding: var(--header-padding-y) var(--header-padding-x);
	}

	.header-banner {
		max-width: var(--content-max-width);
		margin: 0 auto;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
	}

	.header-text {
		flex: 1;
	}

	.site-title {
		margin: 0 0 0.15rem 0;
		font-size: 1.75rem;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1;
	}

	.site-title a {
		color: var(--accent);
		text-decoration: none;
	}

	.site-title a:hover {
		color: var(--accent);
	}

	.header-tagline {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1em;
	}

	.header-tagline a {
		color: var(--accent);
		text-decoration: none;
	}

	.header-tagline a:hover {
		color: var(--text-link-hover);
	}

	.header-sub {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 300;
		color: var(--accent);
		line-height: 1.1em;
	}

	.header-gif {
		flex-shrink: 0;
	}

	.header-gif img {
		width: 60px;
		height: 60px;
		object-fit: contain;
	}

	/* Social bars */
	.social-bar {
		display: flex;
		gap: 0.5rem;
	}

	.social-bar a {
		display: flex;
		align-items: center;
		color: rgba(255, 255, 255, 0.5);
		transition: color 0.2s;
	}

	.social-bar a:hover {
		color: var(--accent);
	}

	.social-bar-desktop {
		display: flex;
	}

	.social-bar-mobile {
		display: none;
	}

	/* Top nav */
	.top-nav {
		max-width: var(--content-max-width);
		margin: 0.75rem auto 0;
		display: flex;
		gap: 1.5rem;
	}

	.nav-link {
		color: #ffffff;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 300;
		transition: color 0.2s;
	}

	.nav-link:hover {
		color: var(--accent);
	}

	/* Footer */
	.site-footer {
		background: var(--bg-footer);
		padding: 2rem var(--header-padding-x);
		margin-top: 3rem;
		border-top: 1px solid var(--border);
	}

	.footer-inner {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.newsletter {
		margin-bottom: 2rem;
	}

	.newsletter h3 {
		font-size: 0.875rem;
		text-transform: lowercase;
		letter-spacing: 0.1em;
		margin: 0 0 1rem 0;
		color: var(--text-secondary);
		font-weight: 300;
	}

	.newsletter-form {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.newsletter-form input {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-primary);
		font-size: 0.875rem;
		font-family: var(--font-body);
		font-weight: 300;
		outline: none;
		transition: border-color 0.2s;
		min-width: 120px;
	}

	.newsletter-form input::placeholder {
		color: var(--text-muted);
	}

	.newsletter-form input:focus {
		border-color: var(--accent);
	}

	.newsletter-form button {
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-primary);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		cursor: pointer;
		font-family: var(--font-body);
		font-weight: 300;
		transition: all 0.2s;
	}

	.newsletter-form button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.footer-copyright {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.copyright-line {
		margin: 0;
	}

	.footer-social {
		margin-top: 1.5rem;
	}

	.footer-social a {
		color: var(--text-muted);
		transition: color 0.2s;
	}

	.footer-social a:hover {
		color: var(--accent);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.site-header {
			padding: 1rem var(--header-padding-x);
		}

		.header-banner {
			flex-direction: column;
			gap: 1rem;
			align-items: flex-start;
		}

		.header-gif {
			width: 48px;
			height: 48px;
		}

		.header-gif img {
			width: 48px;
			height: 48px;
		}

		.site-title {
			font-size: 1.35rem;
		}

		.header-tagline,
		.header-sub {
			font-size: 0.75rem;
		}

		.social-bar-desktop {
			display: none;
		}

		.social-bar-mobile {
			display: flex;
			padding: 0.5rem 0;
		}

		.site-footer {
			padding: 2rem var(--header-padding-x);
		}

		.newsletter-form {
			flex-direction: column;
		}

		.newsletter-form input {
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.header-banner {
			gap: 0.75rem;
		}

		.site-title {
			font-size: 1.15rem;
		}
	}
</style>
