---
// BlogCard — Wix-style blog post card
// Matching the screenshot: avatar + author, date, title, image, stats
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

function formatDate(date: Date): string {
	return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<article class="blog-card">
	<div class="card-header">
		<div class="author-info">
			<div class="avatar">R</div>
			<span class="author-name">~rooks /l</span>
		</div>
		<time class="post-date">{post.data.pubDate ? formatDate(post.data.pubDate) : ''}</time>
	</div>

	<h2 class="card-title">{post.data.title}</h2>

	{post.data.image && (
		<figure class="card-image">
			<img src={post.data.image} alt={post.data.title} loading="lazy" />
			{post.data.imageCaption && (
				<figcaption class="image-caption">{post.data.imageCaption}</figcaption>
			)}
		</figure>
	)}

	{post.data.excerpt && (
		<div class="card-excerpt">{post.data.excerpt}</div>
	)}

	<div class="card-footer">
		{post.data.tags && post.data.tags.length > 0 && (
			<div class="card-tags">
				<span class="tag-label">In Progress...</span>
				{post.data.tags.map((tag: string) => (
					<a href={`/category/${tag}`} class="tag">{tag}</a>
				))}
			</div>
		)}

		<div class="social-actions">
			<button class="social-btn" aria-label="Share on Facebook" title="Share">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
			</button>
			<button class="social-btn" aria-label="Share on X/Twitter" title="Share">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
			</button>
			<button class="social-btn" aria-label="Share on LinkedIn" title="Share">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
			</button>
			<button class="social-btn" aria-label="Copy link" title="Link">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
			</button>
		</div>

		<div class="post-stats">
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
				{post.data.views || 0}
			</span>
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
				{post.data.comments || 0}
			</span>
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
				{post.data.likes || 0}
			</span>
		</div>
	</div>
</article>

<style is:global>
	/* Blog Card */
	.blog-card {
		background: var(--card-bg);
		border: 1px solid var(--border);
		padding: 24px;
		margin-bottom: 24px;
		backdrop-filter: blur(4px);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12px;
		font-size: 12px;
	}

	.author-info {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		color: white;
		font-weight: 600;
	}

	.author-name {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
	}

	.post-date {
		color: var(--text-muted);
		font-size: 12px;
		font-family: var(--font-body);
	}

	.card-title {
		margin: 0 0 16px 0;
		font-size: 1.375rem;
		font-family: var(--font-title);
		font-weight: 400;
		color: var(--accent);
		line-height: 1.3;
	}

	.card-image {
		margin: 0 0 16px 0;
	}

	.card-image img {
		width: 100%;
	}

	.image-caption {
		margin-top: 8px;
		font-size: 12px;
		color: var(--text-muted);
		text-align: center;
		font-family: var(--font-body);
	}

	.card-excerpt {
		margin: 0 0 16px 0;
		font-size: 13px;
		line-height: 1.6;
		color: var(--text);
		font-family: var(--font-body);
	}

	.card-footer {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.card-tags {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.tag-label {
		font-size: 11px;
		color: var(--text-muted);
		font-family: var(--font-body);
	}

	.tag {
		display: inline-block;
		color: var(--accent);
		font-size: 11px;
		font-family: var(--font-body);
		text-decoration: none;
		padding: 2px 0;
		border-bottom: 1px solid var(--border);
		transition: border-color var(--transition-fast);
	}

	.tag:hover {
		border-color: var(--accent);
		opacity: 1;
	}

	.social-actions {
		display: flex;
		gap: 8px;
		align-items: center;
	}

	.social-btn {
		background: none;
		border: none;
		color: var(--text-muted);
		cursor: pointer;
		padding: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color var(--transition-fast);
	}

	.social-btn:hover {
		color: var(--accent);
	}

	.post-stats {
		display: flex;
		gap: 16px;
		font-size: 11px;
		color: var(--text-muted);
		font-family: var(--font-body);
	}

	.stat {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.stat svg {
		opacity: 0.6;
	}
</style>
