---
// BlogCard - Wix blog post card structure
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

function formatDate(date: Date): string {
	return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<article class="blog-post-card">
	<!-- Image at top -->
	{post.data.image && (
		<a href={post.url} class="post-image-link">
			<img 
				src={post.data.image} 
				alt={post.data.title}
				class="post-image"
				loading="lazy"
			/>
		</a>
	)}
	
	<div class="post-content">
		<!-- Meta: author + date -->
		<div class="post-meta">
			<div class="author-info">
				<div class="avatar">
					<img 
						src="/images/avatar-purple.jpg" 
						alt="Author avatar"
						class="avatar-img"
						onerror="this.style.display='none'"
					/>
				</div>
				<span class="author-name">~rooks /l</span>
			</div>
			<time class="post-date">
				{post.data.pubDate ? formatDate(post.data.pubDate) : ''}
				{post.data.readTime && ` • ${post.data.readTime}`}
			</time>
		</div>
		
		<!-- Title -->
		<h2 class="post-title">
			<a href={post.url}>{post.data.title}</a>
		</h2>
		
		<!-- Excerpt -->
		{post.data.description && (
			<p class="post-excerpt">{post.data.description}</p>
		)}
		
		<!-- Social sharing -->
		<div class="social-actions">
			<button class="social-btn" aria-label="Share on Facebook">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/>
				</svg>
			</button>
			<button class="social-btn" aria-label="Share on X/Twitter">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</button>
			<button class="social-btn" aria-label="Share on LinkedIn">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
				</svg>
			</button>
			<button class="social-btn" aria-label="Copy link">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
					<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
				</svg>
			</button>
		</div>
		
		<!-- Stats -->
		<div class="post-stats">
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
					<circle cx="12" cy="12" r="3"/>
				</svg>
				{post.data.views || 0}
			</span>
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
				</svg>
				{post.data.comments || 0}
			</span>
			<span class="stat">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
				</svg>
				{post.data.likes || 0}
			</span>
		</div>
	</div>
</article>

<style is:global>
/* Blog post card - Wix match */
.blog-post-card {
  background: rgba(0, 0, 0, 0.95);
  border: 1px solid var(--accent);
  margin-bottom: 40px;
  overflow: hidden;
  font-family: var(--font-body);
}

.post-image-link {
  display: block;
  width: 100%;
}

.post-image {
  width: 100%;
  height: auto;
  display: block;
}

.post-content {
  padding: 24px;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  font-size: 12px;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.author-name {
  color: var(--accent);
  font-size: 12px;
  font-weight: 100;
  font-family: var(--font-body);
}

.post-date {
  color: var(--accent);
  font-size: 12px;
  font-weight: 100;
  font-family: var(--font-body);
}

.post-title {
  margin: 0 0 12px;
  font-size: 28px;
  font-weight: 100;
  line-height: 1.2;
  color: var(--accent);
  font-family: var(--font-body);
}

.post-title a {
  color: var(--accent);
  text-decoration: none;
}

.post-title a:hover {
  opacity: 0.8;
}

.post-excerpt {
  margin: 0 0 20px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--accent);
  font-family: var(--font-body);
}

.social-actions {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.social-btn {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.social-btn:hover {
  opacity: 1;
}

.post-stats {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: var(--accent);
  opacity: 0.7;
}

.stat {
  display: flex;
  align-items: center;
  gap: 4px;
}

.stat svg {
  opacity: 0.6;
}
</style>
