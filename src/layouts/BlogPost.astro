---
// BlogPost layout — matching Wix dark theme + card structure
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from '../components/SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & { readTime?: number };

const { title, description, pubDate, updatedDate, categories, image, imageCaption, readTime } = Astro.props;
---

<SiteLayout title={title}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>

	<main class="blog-post">
		<article class="post-card">
			{image && (
				<figure class="hero-image">
					<img src={image} alt={`Hero image for ${title}`} loading="eager" />
					{imageCaption && <figcaption class="image-caption">{imageCaption}</figcaption>}
				</figure>
			)}

			<div class="post-header">
				<div class="author-info">
					<div class="avatar">R</div>
					<span class="author-name">~rooks /l</span>
				</div>
				<time class="post-date">{pubDate ? pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}{readTime ? ` · ${readTime}` : ''}</time>
			</div>

			<h1 class="post-title">{title}</h1>

			{updatedDate && (
				<p class="last-updated">Last updated on <FormattedDate date={updatedDate} /></p>
			)}

			<div class="post-content">
				<slot />
			</div>

			{categories && categories.length > 0 && (
				<div class="post-tags">
					{categories.map(cat => (
						<a href={`/category/${cat}`} class="category-tag">{cat}</a>
					))}
				</div>
			)}

			<div class="post-footer">
				<div class="social-actions">
					<button class="social-btn" aria-label="Share on Facebook" title="Share">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
					</button>
					<button class="social-btn" aria-label="Share on X/Twitter" title="Share">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</button>
					<button class="social-btn" aria-label="Share on LinkedIn" title="Share">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</button>
					<button class="social-btn" aria-label="Copy link" title="Link">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
					</button>
				</div>

				<div class="post-stats">
					<span class="stat">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
						{readTime || 0} min
					</span>
					<span class="stat">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
						0
					</span>
					<span class="stat">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
						0
					</span>
				</div>
			</div>
		</article>
	</main>
</SiteLayout>

<style>
	.blog-post {
		max-width: var(--post-max-width);
		margin: 0 auto;
		padding: 20px 20px 60px;
	}

	.post-card {
		background: rgba(0, 0, 0, 0.95);
		border: 1px solid var(--accent);
		padding: 0;
		overflow: hidden;
	}

	.post-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 12px;
		font-size: 12px;
		padding: 20px 24px 0;
	}

	.author-info {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		color: white;
		font-weight: 100;
	}

	.author-name {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
		}

		.post-date {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
		}

		.post-title {
		margin: 0;
		font-size: 28px;
		font-family: var(--font-body);
		font-weight: var(--font-weight-heading);
		color: var(--accent);
		line-height: 1.2;
		padding: 12px 24px 0;
	}

	.last-updated {
		font-size: 11px;
		color: var(--accent-dim);
		font-style: italic;
		margin: 0;
		padding: 0 24px;
		font-family: var(--font-body);
		}

		.hero-image {
		margin: 0;
	}

	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	.image-caption {
		margin-top: 8px;
		font-size: 12px;
		color: var(--text-muted);
		text-align: center;
		font-family: var(--font-body);
	}

	.post-content {
		color: var(--accent);
		line-height: 1.7;
		font-size: 14px;
		font-family: var(--font-body);
		font-weight: var(--font-weight-body);
		padding: 0 24px 24px;
	}

	.post-content p {
		margin-bottom: 1.25em;
		color: var(--text-secondary);
		text-align: left;
	}

	.post-content h1,
	.post-content h2,
	.post-content h3 {
		color: var(--accent);
		margin-top: 2em;
		margin-bottom: 0.75em;
		font-weight: var(--font-weight-heading);
		text-align: left;
	}

	.post-content h1 { font-size: 28px; }
	.post-content h2 { font-size: 22px; }
	.post-content h3 { font-size: 18px; }

	.post-content a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-content a:hover {
		opacity: 0.75;
	}

	.post-content blockquote {
		border-left: 2px solid var(--accent-subtle);
		padding-left: 1.5em;
		margin: 1.5em 0;
		color: var(--text-muted);
		font-style: italic;
	}

	.post-content img,
	.post-content figure img {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 1.5em auto;
	}

	.post-content figure {
		margin: 1.5em auto;
		text-align: center;
	}

	.post-content figure figcaption {
		font-size: 12px;
		color: var(--text-muted);
		margin-top: 0.5em;
		font-family: var(--font-body);
		text-align: center;
	}

	.post-content video,
	.post-content iframe {
		display: block;
		margin: 1.5em auto;
		max-width: 100%;
	}

	.post-content ul,
	.post-content ol {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
		text-align: left;
	}

	.post-content li {
		margin-bottom: 0.5em;
	}

	.post-content hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2em 0;
	}

	.post-tags {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 24px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
		padding-left: 24px;
		padding-right: 24px;
	}

	.category-tag {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
		text-decoration: none;
		padding: 2px 0;
		border-bottom: 1px solid var(--border);
		transition: border-color 0.2s;
	}

	.category-tag:hover {
		border-color: var(--accent);
		opacity: 1;
	}

	.post-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 20px;
		padding-top: 16px;
		padding-left: 24px;
		padding-right: 24px;
		border-top: 1px solid var(--border);
	}

	.social-actions {
		display: flex;
		gap: 12px;
	}

	.social-btn {
		background: none;
		border: none;
		color: var(--accent);
		cursor: pointer;
		padding: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.7;
		transition: opacity 0.2s;
	}

	.social-btn:hover {
		opacity: 1;
	}

	.post-stats {
		display: flex;
		gap: 16px;
		font-size: 12px;
		color: var(--accent-dim);
		font-family: var(--font-body);
		}

		.stat {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.stat svg {
		opacity: 0.6;
	}

	@media (max-width: 768px) {
		.blog-post {
			padding: 16px 20px 40px;
		}

		.post-card {
			padding: 0;
		}

		.post-header {
			padding: 16px 16px 0;
		}

		.post-title {
			font-size: 22px;
			padding: 12px 16px 0;
		}

		.post-content {
			font-size: 14px;
			padding: 0 16px 16px;
		}

		.post-footer {
			padding-left: 16px;
			padding-right: 16px;
		}

		.post-tags {
			padding-left: 16px;
			padding-right: 16px;
		}
	}
</style>
