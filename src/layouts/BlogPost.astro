---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SiteLayout from '../components/SiteLayout.astro';

const { title, description, pubDate, categories, image, slug, readTime } = Astro.props;
---

<SiteLayout title={title}>
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>

	<main class="blog-post">
		<article>
			<header class="section-header">
				<h1 class="post-title">{title}</h1>
				<div class="author-line">
					<span class="author-name">~rooks /|\\</span>
					<span class="separator">·</span>
					<time class="post-date">
						{pubDate ? pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}
					</time>
					<span class="separator">·</span>
					<span class="read-time">{readTime} min read</span>
				</div>
			</header>

			<div class="post-content">
				<slot />
			</div>

			<footer class="section-footer">
				{categories && categories.length > 0 && (
					<div class="post-tags">
						{categories.map((cat, i) => (
							<>
								<a href={`/category/${cat}`} class="category-tag">{cat}</a>
								{i < categories.length - 1 && <span class="tag-separator">·</span>}
							</>
						))}
					</div>
				)}
			</footer>
		</article>
	</main>
</SiteLayout>

<style>
	.blog-post {
		max-width: var(--post-max-width);
		margin: 0 auto;
		padding: 20px var(--header-padding-x) 60px;
	}

	article {
		background: transparent;
		border: none;
	}

	.section-header {
		margin-bottom: 20px;
	}

	.post-title {
		margin: 0;
		font-size: 28px;
		font-family: var(--font-body);
		font-weight: var(--font-weight-heading);
		color: var(--accent);
		line-height: 1.2;
		margin-bottom: 8px;
	}

	.author-line {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		color: var(--text-muted);
	}

	.author-name {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
	}

	.separator {
		color: var(--text-muted);
	}

	.post-date {
		color: var(--text-muted);
		font-size: 12px;
		font-family: var(--font-body);
	}

	.read-time {
		color: var(--text-muted);
		font-size: 12px;
		font-family: var(--font-body);
	}

	.post-content {
		color: var(--text-secondary);
		line-height: 1.7;
		font-size: 14px;
		font-family: var(--font-body);
		font-weight: var(--font-weight-body);
	}

	.post-content p {
		margin-bottom: 1.25em;
		color: var(--text-secondary);
		text-align: left;
	}

	.post-content h1,
	.post-content h2,
	.post-content h3 {
		color: var(--accent);
		margin-top: 2em;
		margin-bottom: 0.75em;
		font-weight: var(--font-weight-heading);
		text-align: left;
	}

	.post-content h1 { font-size: 28px; }
	.post-content h2 { font-size: 22px; }
	.post-content h3 { font-size: 18px; }

	.post-content a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-content a:hover {
		opacity: 0.75;
	}

	.post-content blockquote {
		border-left: 2px solid var(--accent);
		padding-left: 1.5em;
		margin: 1.5em 0;
		color: var(--text-muted);
		font-style: italic;
	}

	.post-content img,
	.post-content figure img {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 1.5em auto;
	}

	.post-content figure {
		margin: 1.5em auto;
		text-align: center;
	}

	.post-content figure figcaption {
		font-size: 12px;
		color: var(--text-muted);
		margin-top: 0.5em;
		font-family: var(--font-body);
		text-align: center;
	}

	.post-content video,
	.post-content iframe {
		display: block;
		margin: 1.5em auto;
		max-width: 100%;
	}

	.post-content ul,
	.post-content ol {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
		text-align: left;
	}

	.post-content li {
		margin-bottom: 0.5em;
	}

	.post-content hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 2em 0;
	}

	.section-footer {
		margin-top: 24px;
		padding-top: 20px;
		border-top: 1px solid var(--border);
	}

	.post-tags {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.category-tag {
		color: var(--accent);
		font-size: 12px;
		font-family: var(--font-body);
		text-decoration: none;
		opacity: 0.8;
		transition: opacity 0.2s;
	}

	.category-tag:hover {
		opacity: 1;
	}

	.tag-separator {
		color: var(--text-muted);
		font-size: 12px;
	}

	@media (max-width: 768px) {
		.blog-post {
			padding: 16px 16px 40px;
		}

		.post-title {
			font-size: 22px;
		}
	}
</style>
