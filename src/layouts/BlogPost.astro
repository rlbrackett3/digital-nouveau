---
// BlogPost layout - Wix-inspired light theme
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from '../components/SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, categories } = Astro.props;
---

<SiteLayout title={title}>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<main class="blog-post">
		<article>
			<div class="prose">
				<div class="post-header">
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					{categories && categories.length > 0 && (
						<div class="post-categories">
							{categories.map(cat => (
								<a href={`/category/${cat}`} class="category-tag">{cat}</a>
							))}
						</div>
					)}
					<hr />
				</div>
				<slot />
			</div>
		</article>
	</main>
</SiteLayout>

<style>
	.blog-post {
		max-width: 740px;
		margin: 2rem auto;
		padding: 0 2rem;
	}

	.prose {
		color: var(--text-primary);
		line-height: 1.8;
		font-size: 1.05rem;
	}

	.prose p {
		margin-bottom: 1.5em;
	}

	.prose h1,
	.prose h2,
	.prose h3 {
		color: var(--text-primary);
		margin-top: 2em;
	}

	.prose a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.prose a:hover {
		color: var(--text-primary);
	}

	.prose blockquote {
		border-left: 3px solid var(--border);
		padding-left: 1.5em;
		margin: 1.5em 0;
		color: var(--text-secondary);
		font-style: italic;
	}

	.prose img {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
		margin: 1.5em 0;
	}

	.prose ul,
	.prose ol {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.prose li {
		margin-bottom: 0.5em;
	}

	.post-header {
		margin-bottom: 2em;
		padding-bottom: 1em;
	}

	.post-header h1 {
		margin: 0.5em 0;
		font-size: 2.25rem;
		line-height: 1.2;
		color: var(--text-primary);
	}

	.post-meta {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.last-updated-on {
		font-style: italic;
		color: var(--text-muted);
		margin-top: 0.25rem;
	}

	.post-categories {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1em;
	}

	.category-tag {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		background: #f0f0f0;
		color: var(--text-secondary);
		text-decoration: none;
		border-radius: 2px;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: lowercase;
		transition: background 0.2s;
	}

	.category-tag:hover {
		background: #e0e0e0;
	}

	@media (max-width: 768px) {
		.blog-post {
			padding: 0 1rem;
		}

		.post-header h1 {
			font-size: 1.75rem;
		}

		.prose {
			font-size: 1rem;
		}
	}
</style>