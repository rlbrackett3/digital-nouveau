---
// BlogPost layout using SiteLayout for consistent dark theme
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SiteLayout from '../components/SiteLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, categories } = Astro.props;
---

<SiteLayout title={title}>
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<main class="blog-post">
		<article>
			<div class="prose">
				<div class="title">
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					{categories && categories.length > 0 && (
						<div class="post-categories">
							{categories.map(cat => (
								<a href={`/category/${cat}`} class="category-tag">{cat}</a>
							))}
						</div>
					)}
					<hr />
				</div>
				<slot />
			</div>
		</article>
	</main>
</SiteLayout>

<style>
	.blog-post {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 2rem auto;
		padding: 0 1em;
	}

	.prose {
		color: #e0e0e0;
		line-height: 1.8;
	}

	.prose p {
		margin-bottom: 1.5em;
	}

	.prose h1,
	.prose h2,
	.prose h3 {
		color: #fff;
		margin-top: 2em;
	}

	.prose a {
		color: #64b5f6;
		text-decoration: underline;
	}

	.prose blockquote {
		border-left: 3px solid #555;
		padding-left: 1.5em;
		margin: 1.5em 0;
		color: #bbb;
		font-style: italic;
	}

	.prose img {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 1.5em 0;
	}

	.prose ul,
	.prose ol {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.prose li {
		margin-bottom: 0.5em;
	}

	.title {
		margin-bottom: 2em;
		padding-bottom: 1em;
	}

	.title h1 {
		margin: 0.5em 0;
		font-size: 2.5rem;
		line-height: 1.2;
		color: #fff;
	}

	.date {
		color: #888;
		font-size: 0.875rem;
	}

	.last-updated-on {
		font-style: italic;
		color: #666;
	}

	.post-categories {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1em;
	}

	.category-tag {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		background: #2a2a4a;
		color: #e0e0e0;
		text-decoration: none;
		border-radius: 4px;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		transition: background 0.2s;
	}

	.category-tag:hover {
		background: #3a3a5a;
	}

	@media (max-width: 720px) {
		.blog-post {
			padding: 0 0.5em;
		}

		.title h1 {
			font-size: 1.75rem;
		}
	}
</style>
