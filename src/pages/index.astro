---
// Home page — Feed layout matching Wix screenshot
// Main featured post + Recent Posts (3 columns) + Comments
import SiteLayout from '../components/SiteLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', () => true);
const sortedPosts = posts.sort((a, b) => {
	const dateA = a.data.pubDate ? a.data.pubDate.getTime() : 0;
	const dateB = b.data.pubDate ? b.data.pubDate.getTime() : 0;
	return dateB - dateA;
});
const recentPosts = sortedPosts.slice(1, 4);
---

<SiteLayout>
	<main>
		<!-- Featured/first post card -->
		{sortedPosts.length > 0 && (
			<BlogCard post={sortedPosts[0]} />
		)}

		<!-- Recent posts section -->
		{recentPosts.length > 0 && (
			<section class="recent-posts">
				<h3 class="section-title">Recent Posts</h3>
				<div class="posts-grid">
					{recentPosts.map(post => (
						<a href={`/blog/${post.slug}`} class="post-thumbnail">
							{post.data.image && (
								<div class="thumbnail-image">
									<img src={post.data.image} alt={post.data.title} loading="lazy" />
								</div>
							)}
							<div class="thumbnail-info">
								<h4>{post.data.title}</h4>
								<div class="thumbnail-stats">
									<span class="stat">
										<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
										{post.data.views || 0}
									</span>
									<span class="stat">
										<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
										{post.data.comments || 0}
									</span>
									<span class="stat">
										<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
										{post.data.likes || 0}
									</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>
		)}

		<!-- Comments section -->
		<section class="comments-section">
			<h3 class="section-title">Comments</h3>
			<div class="comment-form-wrapper">
				<div class="comment-author-preview">
					<div class="comment-avatar">R</div>
				</div>
				<div class="comment-form">
					<textarea placeholder="Write a comment..." rows="3"></textarea>
					<button type="submit" class="comment-submit">Post Comment</button>
				</div>
			</div>
		</section>
	</main>
</SiteLayout>

<style is:global>
	.section-title {
		font-size: 14px;
		font-family: var(--font-body);
		font-weight: 400;
		color: var(--accent);
		margin: 0 0 16px 0;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* Recent Posts Grid */
	.recent-posts {
		margin: 40px 0;
		padding-top: 30px;
		border-top: 1px solid var(--border);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	.post-thumbnail {
		display: block;
		text-decoration: none;
		background: var(--card-bg);
		border: 1px solid var(--border);
		overflow: hidden;
		transition: border-color var(--transition-fast);
		backdrop-filter: blur(4px);
	}

	.post-thumbnail:hover {
		border-color: var(--accent);
	}

	.thumbnail-image {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.thumbnail-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.thumbnail-info {
		padding: 12px;
	}

	.thumbnail-info h4 {
		margin: 0 0 8px 0;
		font-size: 13px;
		font-family: var(--font-title);
		font-weight: 400;
		color: var(--accent);
		line-height: 1.3;
	}

	.thumbnail-stats {
		display: flex;
		gap: 10px;
		font-size: 10px;
		color: var(--text-muted);
		font-family: var(--font-body);
	}

	.thumbnail-stats .stat {
		display: flex;
		align-items: center;
		gap: 3px;
	}

	.thumbnail-stats .stat svg {
		opacity: 0.5;
	}

	/* Comments Section */
	.comments-section {
		margin: 40px 0;
		padding-top: 30px;
		border-top: 1px solid var(--border);
	}

	.comment-form-wrapper {
		background: var(--card-bg);
		border: 1px solid var(--border);
		padding: 20px;
		backdrop-filter: blur(4px);
	}

	.comment-author-preview {
		margin-bottom: 12px;
	}

	.comment-avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		color: white;
		font-weight: 600;
	}

	.comment-form textarea {
		width: 100%;
		padding: 10px 12px;
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font-body);
		font-size: 13px;
		line-height: 1.5;
		resize: vertical;
		outline: none;
		transition: border-color var(--transition-fast);
		margin-bottom: 10px;
	}

	.comment-form textarea:focus {
		border-color: var(--accent);
	}

	.comment-form textarea::placeholder {
		color: var(--text-muted);
	}

	.comment-submit {
		padding: 8px 16px;
		background: var(--accent);
		color: var(--bg);
		border: none;
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 500;
		cursor: pointer;
		transition: opacity var(--transition-fast);
	}

	.comment-submit:hover {
		opacity: 0.85;
	}

	@media (max-width: 768px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
