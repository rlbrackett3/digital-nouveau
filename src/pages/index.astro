---
// Main feed — full post body inline, dynamic height
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import remarkGfm from 'remark-gfm';

const posts = await getCollection('blog', () => true);
const sortedPosts = posts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return dateB - dateA;
});

const processor = unified()
	.use(remarkParse, { gfm: true })
	.use(remarkGfm)
	.use(remarkRehype, { allowDangerousHtml: true })
	.use(rehypeStringify, { allowDangerousHtml: true });

// Pre-render full post HTML for each card
const postsData = await Promise.all(sortedPosts.map(async (post) => {
	// Fix body image paths: relative Wix images need /images/ prefix
	let bodyContent = post.body || '';
	bodyContent = bodyContent.replace(/(<img[^>]+src=")([^\/][^"]*?)(")/g, '$1/images/$2$3');
	bodyContent = bodyContent.replace(/!\[([^\]]*)\]\(([^\/][^)]*?)\)/g, '![$1](/images/$2)');
	const html = await processor.process(bodyContent);
	const dateStr = post.data.pubDate
		? new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
		: '';
	return {
		id: post.id,
		title: post.data.title,
		image: post.data.image,
		date: dateStr,
		readTime: post.data.readTime,
		categories: post.data.categories || [],
		views: (post.data.views as number) || 0,
		likes: (post.data.likes as number) || 0,
		comments: (post.data.comments as number) || 0,
		contentHTML: String(html.value),
	};
}));
---

<SiteLayout>
	<main class="feed-page">
		<div class="feed-container" id="feed-container">
		{postsData.map(pc => (
			<article class="feed-card" data-cats={JSON.stringify(pc.categories)} data-post-id={pc.id}>
				<a href={`/blog/${pc.id}`} class="feed-card-link">
					{pc.image && (
						<div class="feed-card-image">
							<img src={pc.image} alt="" loading="lazy" />
						</div>
					)}
					<div class="feed-card-body">
						<time class="feed-card-date">{pc.date}{pc.readTime ? ` : ${pc.readTime}` : ''}</time>
						<h2 class="feed-card-title">{pc.title}</h2>
						<div class="feed-card-content" set:html={pc.contentHTML}></div>
						<div class="feed-card-stats">
							<span class="feed-stat">{pc.views} views</span>
							<span class="feed-stat">{pc.comments} comments</span>
							<span class="feed-stat">{pc.likes} likes</span>
						</div>
						<span class="feed-card-read-more">Read More &gt;~</span>
					</div>
				</a>
			</article>
		))}
		</div>

		<div class="scroll-sentinel" id="scroll-sentinel"></div>
		<div class="load-more" id="load-more"><span class="loading-dots">loading ~</span></div>
	</main>

	<script is:inline>
	(function() {
		var BATCH = 3;
		var grid = document.getElementById('feed-container');
		var sentinel = document.getElementById('scroll-sentinel');
		var loadMore = document.getElementById('load-more');
		var allCards = Array.prototype.slice.call(grid.querySelectorAll('.feed-card'));
		var visibleCards = allCards;
		var shown = 0;

		function showBatch() {
			var end = Math.min(shown + BATCH, visibleCards.length);
			for (var i = shown; i < end; i++) {
				visibleCards[i].style.display = '';
				visibleCards[i].classList.add('visible');
			}
			shown = end;
			if (shown >= visibleCards.length && loadMore) {
				loadMore.style.display = 'none';
			} else if (loadMore) {
				loadMore.style.display = 'block';
			}
		}

		showBatch();

		if (sentinel) {
			var observer = new IntersectionObserver(
				function(entries) {
					if (entries[0].isIntersecting && shown < visibleCards.length) {
						showBatch();
					}
				},
				{ rootMargin: '300px' }
			);
			observer.observe(sentinel);
		}
	})();
	</script>
</SiteLayout>

<style is:global>
.feed-page {
	max-width: var(--content-max-width);
	margin: 0 auto;
	padding: 20px var(--header-padding-x);
}

.feed-container {
	display: flex;
	flex-direction: column;
	gap: 15px;
	max-width: var(--content-max-width);
	margin: 0 auto;
}

.feed-card {
	border: 1px solid rgba(28, 235, 244, 0.5);
	background: rgba(0, 0, 0, 0.75);
	display: none;
	transition: border-color 0.2s;
}

.feed-card:hover {
	border-color: var(--accent);
}

.feed-card.visible {
	display: block;
	animation: cardIn 0.3s ease-out forwards;
}

@keyframes cardIn {
	from { opacity: 0; transform: translateY(8px); }
	to { opacity: 1; transform: translateY(0); }
}

.feed-card-link {
	text-decoration: none;
	display: flex;
	flex-direction: column;
	color: inherit;
	height: 100%;
}

.feed-card-image {
	width: 100%;
	overflow: hidden;
	background: rgba(28, 235, 244, 0.05);
}

.feed-card-image img {
	width: 100%;
	height: auto;
	display: block;
}

.feed-card-body {
	padding: 24px 28px;
}

.feed-card-date {
	font-size: 12px;
	color: rgba(28, 235, 244, 0.5);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	display: block;
	margin-bottom: 8px;
}

.feed-card-title {
	font-size: 22px;
	font-weight: var(--font-weight-body);
	color: var(--accent);
	font-family: var(--font-body);
	margin: 0 0 16px;
	line-height: 1.3;
}

.feed-card-title:hover {
	color: #ff4040;
}

/* Full post content — dynamic height, inline images */
.feed-card-content {
	font-size: 14px;
	color: rgba(255, 255, 255, 0.6);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	line-height: 1.7;
	margin: 0 0 16px;
}

.feed-card-content p {
	margin: 0 0 1em;
}

.feed-card-content p:last-child {
	margin-bottom: 0;
}

.feed-card-content img {
	max-width: 100%;
	height: auto;
	display: block;
	margin: 1.5em auto;
}

.feed-card-content figure {
	margin: 1.5em 0;
}

.feed-card-content figure img {
	margin: 0;
}

.feed-card-content iframe,
.feed-card-content video {
	max-width: 100%;
	display: block;
	margin: 1.5em auto;
}

.feed-card-content h1,
.feed-card-content h2,
.feed-card-content h3 {
	color: var(--accent);
	font-weight: var(--font-weight-body);
	margin: 1.5em 0 0.75em;
	line-height: 1.3;
}

.feed-card-content h1 { font-size: 1.4em; }
.feed-card-content h2 { font-size: 1.2em; }
.feed-card-content h3 { font-size: 1.1em; }

.feed-card-content a {
	color: var(--accent);
	text-decoration: underline;
}

.feed-card-content blockquote {
	border-left: 2px solid rgba(28, 235, 244, 0.3);
	padding-left: 1em;
	margin: 1em 0;
	color: rgba(28, 235, 244, 0.6);
	font-style: italic;
}

.feed-card-content ul,
.feed-card-content ol {
	margin: 0.5em 0 1em;
	padding-left: 1.5em;
}

.feed-card-content li {
	margin-bottom: 0.4em;
}

.feed-card-stats {
	display: flex;
	gap: 20px;
	margin-bottom: 12px;
}

.feed-stat {
	font-size: 12px;
	color: rgba(28, 235, 244, 0.4);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
}

.feed-card-read-more {
	display: block;
	font-size: 12px;
	color: rgba(28, 235, 244, 0.5);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	letter-spacing: 0.03em;
	transition: color 0.2s;
}

.feed-card-link:hover .feed-card-read-more {
	color: #ff4040;
}

.scroll-sentinel {
	height: 1px;
}

.load-more {
	text-align: center;
	padding: 32px 0;
	display: none;
}

.loading-dots {
	color: var(--accent);
	font-size: 13px;
	animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
	0%, 100% { opacity: 0.4; }
	50% { opacity: 1; }
}

@media (max-width: 600px) {
	.feed-card-body {
		padding: 12px 14px;
	}
	.feed-card-title {
		font-size: 16px;
	}
	.feed-card-stats {
		gap: 10px;
		flex-wrap: wrap;
	}
}
</style>
