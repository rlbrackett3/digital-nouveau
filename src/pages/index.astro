---
// Main feed — full posts, list view, infinite scroll
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import remarkGfm from 'remark-gfm';

const posts = await getCollection('blog', () => true);
const sortedPosts = posts.sort((a, b) => {
	const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return dateB - dateA;
});

const processor = unified()
	.use(remarkParse, { gfm: true })
	.use(remarkGfm)
	.use(remarkRehype, { allowDangerousHtml: true })
	.use(rehypeStringify, { allowDangerousHtml: true });

// Pre-render all post content to HTML strings
const postsData = await Promise.all(sortedPosts.map(async (post) => {
	// Fix body image paths: Wix images are relative, need /images/ prefix
	let bodyContent = post.body || '';
	bodyContent = bodyContent.replace(/src="([^\/][^"]*?)"/g, 'src="/images/$1"');
	const html = await processor.process(bodyContent);
	const dateStr = post.data.pubDate
		? new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
		: '';
	return {
		id: post.id,
		title: post.data.title,
		image: post.data.image,
		date: dateStr,
		readTime: post.data.readTime,
		categories: post.data.categories || [],
		views: (post.data.views as number) || 0,
		likes: (post.data.likes as number) || 0,
		comments: (post.data.comments as number) || 0,
		contentHTML: String(html.value),
	};
}));
---

<SiteLayout>
		<main class="feed-page">
			<div class="feed-container" id="feed-container">
		{postsData.map(pc => (
			<article class="feed-card" data-cats={JSON.stringify(pc.categories)} data-post-id={pc.id}>
				<a href={`/blog/${pc.id}`} class="feed-card-link">
					<div class="feed-card-body">
						<time class="feed-card-date">{pc.date}{pc.readTime ? ` · ${pc.readTime}` : ''}</time>
						<h2 class="feed-card-title">{pc.title}</h2>
						<div class="feed-card-content" set:html={pc.contentHTML}></div>
					</div>
				</a>
			</article>
		))}
		</div>

		<div class="scroll-sentinel" id="scroll-sentinel"></div>
		<div class="load-more" id="load-more"><span class="loading-dots">loading ~</span></div>
	</main>
</SiteLayout>

<style is:global>
.feed-page {
	max-width: var(--content-max-width);
	margin: 0 auto;
	padding: 20px var(--header-padding-x);
}

.feed-filters {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
	padding: 12px 0;
	margin-bottom: 24px;
	border-bottom: 1px solid var(--border);
	position: sticky;
	top: 0;
	z-index: 50;
	background: var(--bg);
}

.feed-filter-btn {
	padding: 6px 14px;
	border: 1px solid var(--accent-subtle);
	background: transparent;
	color: var(--accent-dim);
	font-family: var(--font-body);
	font-size: 12px;
	font-weight: var(--font-weight-body);
	cursor: pointer;
	transition: all 0.2s;
	text-transform: lowercase;
	letter-spacing: 0.03em;
}

.feed-filter-btn:hover {
	border-color: var(--accent-dim);
	color: var(--accent);
}

.feed-filter-btn.active {
	border-color: var(--accent);
	color: var(--accent);
	background: var(--accent-faint);
}

.feed-container {
	display: grid;
	gap: 20px;
}

/* Default: single column, full post view */
.feed-container {
	grid-template-columns: 1fr;
	max-width: var(--content-max-width);
	margin: 0 auto;
}

/* Grid view (category filter) - 3 equal columns of square cards */
.feed-container.grid-view {
	grid-template-columns: repeat(3, 1fr);
	gap: 16px;
	max-width: var(--content-max-width);
	margin: 0 auto;
}

/* Cards hidden initially, JS reveals */
.feed-card {
	display: none;
}

.feed-card.visible {
	display: block;
	animation: cardIn 0.3s ease-out forwards;
}

@keyframes cardIn {
	from {
		opacity: 0;
		transform: translateY(12px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.feed-page .feed-card-link {
	text-decoration: none;
	display: flex;
	flex-direction: column;
	background: rgba(0, 0, 0, 0.75) !important;
	border: 1px solid var(--accent);
	overflow: hidden;
	transition: none !important;
	height: 100%;
}

.feed-page .feed-card-link:hover {
	border-color: var(--accent);
	opacity: 1 !important;
	background: rgba(0, 0, 0, 0.75) !important;
}

.feed-page .feed-card-link:hover .feed-card-title {
	color: var(--text-primary-hover);
}

/* Unified card style — grid view square cards */
.grid-view .feed-card-image {
	width: 100%;
	height: 160px;
	overflow: hidden;
	background: var(--accent-ghost);
	flex-shrink: 0;
}

.grid-view .feed-card-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.grid-view .feed-card-body {
	padding: 16px;
	flex: 1;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

.grid-view .feed-card-content {
	flex: 1;
	overflow: hidden;
	display: -webkit-box;
	-webkit-line-clamp: 3;
	-webkit-box-orient: vertical;
	font-size: 12px;
	color: var(--text-muted);
	line-height: 1.5;
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
}

.grid-view .feed-card {
	height: 100%;
}

.grid-view .feed-card-link {
	height: 100%;
	aspect-ratio: 1 / 1;
	display: flex;
	flex-direction: column;
}

/* List view (default "everything") — full width, aligned column */
.list-view .feed-card-image {
	width: 100%;
	background: var(--accent-ghost);
}

.list-view .feed-card-image img {
	width: 100%;
	height: auto;
	display: block;
	object-fit: none;
}

.list-view .feed-card-body {
	padding: 24px 115px;
}

.list-view .feed-card-title {
	font-size: 22px;
	font-weight: var(--font-weight-body);
	color: var(--accent);
	margin: 0 0 12px;
	line-height: 1.3;
	font-family: var(--font-body);
}

.list-view .feed-card-content {
	font-size: 14px;
	color: var(--text-secondary);
	line-height: 1.7;
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
}

.list-view .feed-card-content p {
	margin: 0 0 1em;
}

.list-view .feed-card-content p:last-child {
	margin-bottom: 0;
}

.list-view .feed-card-content img {
	max-width: 100%;
	height: auto;
	display: block;
	margin: 1.5em 0;
}

.list-view .feed-card-content h1,
.list-view .feed-card-content h2,
.list-view .feed-card-content h3 {
	color: var(--accent);
	font-weight: var(--font-weight-body);
	margin: 1.5em 0 0.75em;
	line-height: 1.3;
}

.list-view .feed-card-content h1 { font-size: 1.5em; }
.list-view .feed-card-content h2 { font-size: 1.25em; }
.list-view .feed-card-content h3 { font-size: 1.1em; }

.list-view .feed-card-content a {
	color: var(--accent);
	text-decoration: underline;
}

.list-view .feed-card-content blockquote {
	border-left: 2px solid var(--accent-dim);
	padding-left: 1em;
	margin: 1em 0;
	color: var(--text-muted);
	font-style: italic;
}

.list-view .feed-card-content ul,
.list-view .feed-card-content ol {
	margin: 0.5em 0 1em;
	padding-left: 1.5em;
}

.list-view .feed-card-content li {
	margin-bottom: 0.4em;
}

.list-view .feed-card-date {
	font-size: 12px;
	color: var(--text-muted);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	display: block;
	margin-bottom: 8px;
}

.list-view .feed-card-link {
	border: 1px solid var(--accent);
	background: rgba(0, 0, 0, 0.75) !important;
}

.list-view .feed-card-link:hover {
	border-color: var(--accent);
	opacity: 1 !important;
	background: rgba(0, 0, 0, 0.75) !important;
}

.feed-page .feed-card-link:hover .feed-card-title {
	color: var(--text-primary-hover);
}

.list-view .feed-card-meta {
	display: none;
}

@media (max-width: 768px) {
	.list-view .feed-card-body {
		padding: 16px;
	}
}

.grid-card-no-image {
	background: linear-gradient(135deg, var(--accent-faint), var(--accent-ghost));
}

.feed-card-body {
	padding: 16px;
}

.feed-card-date {
	font-size: 11px;
	color: var(--text-muted);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	display: block;
	margin-bottom: 6px;
}

.feed-card-title {
	font-size: 15px;
	font-weight: var(--font-weight-body);
	color: var(--accent);
	margin: 0 0 8px;
	line-height: 1.35;
	font-family: var(--font-body);
}

.feed-card-content {
	font-size: 12px;
	color: var(--text-muted);
	margin: 0 0 12px;
	line-height: 1.5;
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
}

.scroll-sentinel {
	height: 1px;
}

.load-more {
	text-align: center;
	padding: 32px 0;
	display: none;
}

.loading-dots {
	color: var(--accent);
	font-size: 13px;
	animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
	0%,
	100% {
		opacity: 0.4;
	}
	50% {
		opacity: 1;
	}
}

@media (max-width: 600px) {
	.feed-container {
		grid-template-columns: 1fr;
	}
	.feed-filters {
		position: relative;
		top: 0;
	}
}
</style>

<!-- Client: infinite scroll reveal + category filtering via header nav -->
<script is:inline>
(function() {
	var BATCH = 12;
	var grid = document.getElementById('feed-container');
	var sentinel = document.getElementById('scroll-sentinel');
	var loadMore = document.getElementById('load-more');
	var allCards = Array.prototype.slice.call(grid.querySelectorAll('.feed-card'));
	var mainNavLinks = document.querySelectorAll('.main-nav a');
	var visibleCards = allCards; // current filtered set
	var shown = 0;

	function showBatch() {
		var end = Math.min(shown + BATCH, visibleCards.length);
		for (var i = shown; i < end; i++) {
			visibleCards[i].style.display = '';
			visibleCards[i].classList.add('visible');
		}
		shown = end;
	}

	function setActive(link) {
		mainNavLinks.forEach(function(l) {
			l.classList.remove('active');
			l.style.color = '';
		});
		link.classList.add('active');
		link.style.color = 'var(--accent)';
	}

	function resetAndShow(filter) {
		// Hide all
		allCards.forEach(function(c) {
			c.classList.remove('visible');
			c.style.display = 'none';
		});
		shown = 0;

		// Set view mode
		if (filter === 'all') {
			grid.classList.remove('grid-view');
			grid.classList.add('list-view');
			visibleCards = allCards.slice();
		} else {
			grid.classList.remove('list-view');
			grid.classList.add('grid-view');
			visibleCards = allCards.filter(function(c) {
				var cats = JSON.parse(c.getAttribute('data-cats') || '[]');
				return cats.indexOf(filter) >= 0;
			});
		}

		showBatch();
	}

	// Nav links navigate normally — no client-side interception

	// Infinite scroll
	if (sentinel) {
		var observer = new IntersectionObserver(
			function(entries) {
				if (entries[0].isIntersecting && shown < visibleCards.length) {
					showBatch();
				}
			},
			{ rootMargin: '200px' }
		);
		observer.observe(sentinel);
	}

	// Initial render (show first batch of all cards)
	resetAndShow('all');
})();
</script>
