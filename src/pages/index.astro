---
// Home page - card layout matching Wix screenshot
import SiteLayout from '../components/SiteLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', () => true);
const recentPosts = posts
	.sort((a, b) => {
		const dateA = a.data.pubDate ? a.data.pubDate.getTime() : 0;
		const dateB = b.data.pubDate ? b.data.pubDate.getTime() : 0;
		return dateB - dateA;
	})
	.slice(0, 3);
---

<SiteLayout>
	<main>
		<!-- Main blog card -->
		{posts.length > 0 && (
			<BlogCard post={posts[0]} />
		)}

		<!-- Recent posts section -->
		{recentPosts.length > 0 && (
			<section class="recent-posts">
				<h3>Recent Posts</h3>
				<div class="posts-grid">
					{recentPosts.map(post => (
						<div class="post-thumbnail">
							{post.data.image && (
								<img src={post.data.image} alt={post.data.title} />
							)}
							<h4>{post.data.title}</h4>
							<div class="thumbnail-stats">
								<span>👁️ {post.data.views || 0} views</span>
								<span>💬 {post.data.comments || 0} comments</span>
								<span>❤️ {post.data.likes || 0}</span>
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		<!-- Comments section -->
		<section class="comments-section">
			<h3>Comments</h3>
			<div class="comment-form">
				<textarea placeholder="Write a comment..." rows="3"></textarea>
				<button type="submit">Post Comment</button>
			</div>
		</section>
	</main>
</SiteLayout>

<style is:global>
	.recent-posts {
		margin: 40px 0;
	}

	.recent-posts h3 {
		margin: 0 0 20px 0;
		font-size: 1.25rem;
		color: var(--accent);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.post-thumbnail {
		background: var(--card-bg);
		border: 1px solid var(--border);
		padding: 15px;
		border-radius: 4px;
	}

	.post-thumbnail img {
		width: 100%;
		height: 120px;
		object-fit: cover;
		border-radius: 4px;
		margin-bottom: 10px;
	}

	.post-thumbnail h4 {
		margin: 0 0 10px 0;
		font-size: 1rem;
		color: var(--accent);
		line-height: 1.3;
	}

	.thumbnail-stats {
		display: flex;
		gap: 10px;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.comments-section {
		margin: 40px 0;
	}

	.comments-section h3 {
		margin: 0 0 20px 0;
		font-size: 1.25rem;
		color: var(--accent);
	}

	.comment-form {
		background: var(--card-bg);
		border: 1px solid var(--border);
		padding: 20px;
		border-radius: 4px;
	}

	.comment-form textarea {
		width: 100%;
		padding: 10px;
		background: transparent;
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font);
		font-size: 1rem;
		margin-bottom: 10px;
		resize: vertical;
	}

	.comment-form button {
		padding: 8px 16px;
		background: var(--accent);
		color: var(--bg);
		border: none;
		border-radius: 4px;
		cursor: pointer;
		font-weight: 500;
	}

	.comment-form button:hover {
		opacity: 0.8;
	}

	@media (max-width: 768px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
