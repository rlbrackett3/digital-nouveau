---
// Digital Nouveau - Index page
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '@/consts';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 12);

const categoryDisplay: Record<string, string> = {
	design: 'Design',
	drawings: 'Drawings',
	readings: 'Readings',
	skyfi: 'SkyFi',
	thinkings: 'Thinkings',
	observings: 'Observings',
	teachings: 'Teachings',
	writings: 'Writings',
};
---

<SiteLayout title={SITE_TITLE}>
	<head>
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />
	</head>

	<main class="index-page">
		<header class="site-header">
			<h1>{SITE_TITLE}</h1>
			<p>{SITE_DESCRIPTION}</p>
		</header>

		<nav class="category-nav">
			{CATEGORIES.map(cat => {
				const displayName = categoryDisplay[cat] || cat;
				return <a href={`/category/${cat}`} class="category-link">{displayName}</a>;
			})}
		</nav>

		<div class="post-list">
			{sortedPosts.map(post => (
				<article class="post-preview">
					<h2>
						<a href={`/blog/${post.slug}`}>{post.data.title}</a>
					</h2>
					<time datetime={post.data.pubDate.toISOString()}>
						{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
					</time>
					<p>{post.data.description}</p>
					<div class="post-categories">
						{post.data.categories.map(cat => (
							<a href={`/category/${cat}`} class="category-tag">{cat}</a>
						))}
					</div>
				</article>
			))}
		</div>

		<a href="/blog" class="view-all">View All Posts →</a>
	</main>

	<style>
		.index-page {
			width: 720px;
			max-width: calc(100% - 2em);
			margin: 0 auto;
			padding: 2rem 1em;
		}

		.site-header {
			margin-bottom: 3rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid #333;
		}

		.site-header h1 {
			font-size: 2.5rem;
			color: #fff;
			margin-bottom: 1rem;
		}

		.site-header p {
			color: #888;
			line-height: 1.6;
		}

		.category-nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 3rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid #333;
		}

		.category-link {
			color: #e0e0e0;
			text-decoration: none;
			font-size: 0.875rem;
			letter-spacing: 0.05em;
			text-transform: lowercase;
			padding: 0.25rem 0.5rem;
			border-radius: 4px;
			transition: all 0.2s;
		}

		.category-link:hover {
			color: #fff;
			background: #2a2a4a;
		}

		.post-list {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		.post-preview {
			padding-bottom: 2rem;
			border-bottom: 1px solid #2a2a2a;
		}

		.post-preview h2 {
			margin: 0 0 0.5rem 0;
		}

		.post-preview h2 a {
			color: #fff;
			text-decoration: none;
			transition: color 0.2s;
		}

		.post-preview h2 a:hover {
			color: #64b5f6;
		}

		.post-preview time {
			color: #666;
			font-size: 0.8rem;
		}

		.post-preview p {
			color: #aaa;
			line-height: 1.5;
			margin-top: 0.5rem;
		}

		.post-categories {
			display: flex;
			gap: 0.5rem;
			flex-wrap: wrap;
			margin-top: 0.75rem;
		}

		.category-tag {
			display: inline-block;
			padding: 0.2rem 0.6rem;
			background: #2a2a4a;
			color: #ccc;
			text-decoration: none;
			border-radius: 3px;
			font-size: 0.7rem;
			letter-spacing: 0.05em;
		}

		.category-tag:hover {
			background: #3a3a5a;
		}

		.view-all {
			display: inline-block;
			margin-top: 2rem;
			color: #64b5f6;
			text-decoration: none;
		}

		.view-all:hover {
			color: #fff;
		}

		@media (max-width: 720px) {
			.index-page {
				padding: 1rem 0.5rem;
			}

			.site-header h1 {
				font-size: 1.75rem;
			}
		}
	</style>
</SiteLayout>
