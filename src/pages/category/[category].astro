---
// Category page - 3-column grid matching Wix blog structure
import { getCollection } from 'astro:content';
import SiteLayout from '@/components/SiteLayout.astro';
import { SITE_TITLE, CATEGORIES } from '@/consts';

const { category } = Astro.props;
const allPosts = await getCollection('blog');
const categoryPosts = allPosts
	.filter(post => post.data.categories.includes(category))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.map(post => {
		const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
		const image = post.data.image;
		const dateStr = post.data.pubDate
			? new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
			: '';
		return {
			id: post.id,
			title: post.data.title,
			image,
			date: dateStr,
			readTime: post.data.readTime || Math.max(1, Math.ceil(words / 200)),
			categories: post.data.categories || [],
		};
	});

const categoryDisplay: Record<string, string> = {
	design: 'Design',
	drawings: 'Drawings',
	readings: 'Readings',
	skyfi: 'SkyFi',
	thinkings: 'Thinkings',
	observings: 'Observings',
	teachings: 'Teachings',
	writings: 'Writings',
};

const displayName = categoryDisplay[category] || category;

export function getStaticPaths() {
	return CATEGORIES.map((cat) => ({
		params: { category: cat },
		props: { category: cat },
	}));
}
---

<SiteLayout title={`${displayName} | ${SITE_TITLE}`}>
	<main class="feed-page">
		<div class="feed-container grid-view" id="feed-container">
		{categoryPosts.map(pc => (
			<article class="feed-card" data-cats={JSON.stringify(pc.categories)} data-post-id={pc.id}>
				<a href={`/blog/${pc.id}`} class="feed-card-link">
					{pc.image ? (
						<div class="feed-card-image">
							<img src={pc.image} alt={pc.title} loading="lazy" />
						</div>
					) : ''}
					<div class="feed-card-body">
						<h2 class="feed-card-title">{pc.title}</h2>
						<p class="feed-card-content">{pc.date}</p>
					</div>
				</a>
				<div class="feed-card-meta">
					<div class="feed-card-stats">
						<span class="feed-stat">
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
							{(pc.views as number) || 0}
						</span>
						<span class="feed-stat">
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
							0
						</span>
					</div>
				</div>
			</article>
		))}
		</div>
	</main>
</SiteLayout>
