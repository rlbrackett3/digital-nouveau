---
// Category filter page — unified 3-column square card grid
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', () => true);

// Get all unique categories from posts
const categorySet = new Set();
allPosts.forEach(post => {
	if (post.data.categories) {
		post.data.categories.forEach(cat => categorySet.add(cat));
	}
});

const categories = Array.from(categorySet);

export async function getStaticPaths() {
	const posts = await getCollection('blog', () => true);
	const cats = new Set();
	posts.forEach(p => { if (p.data.categories) p.data.categories.forEach(c => cats.add(c)); });
	return Array.from(cats).map(cat => ({ params: { category: cat } }));
}

const category = Astro.params.category;
const filteredPosts = allPosts
	.filter(post => post.data.categories && post.data.categories.includes(category))
	.sort((a, b) => {
		const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
		const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
		return dateB - dateA;
	});
---

<SiteLayout title={category}>
	<main class="category-page">
		<div class="category-grid">
			{filteredPosts.map(post => {
				const dateStr = post.data.pubDate
					? new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
					: '';
				// Extract text-only body excerpt for posts without images
				const bodyText = (post.body || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
				const excerpt = bodyText.length > 180 ? bodyText.substring(0, 180) + '...' : bodyText;
				return (
					<article class="category-card">
						<a href={`/blog/${post.id}`} class="category-card-link">
							{post.data.image ? (
								<div class="category-card-image">
									<img src={post.data.image} alt={post.data.title} loading="lazy" />
								</div>
							) : (
								<div class="category-card-excerpt">
									<p>{excerpt}</p>
								</div>
							)}
							<div class="category-card-body">
								<time class="category-card-date">{dateStr}</time>
								<h2 class="category-card-title">{post.data.title}</h2>
								<div class="category-card-stats">
									{post.data.views !== undefined && (
										<span class="category-stat">
											<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
											{post.data.views}
										</span>
									)}
									{post.data.likes !== undefined && (
										<span class="category-stat">
											<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
											{post.data.likes}
										</span>
									)}
								</div>
								<span class="category-card-read-more">Read More &gt;~</span>
							</div>
						</a>
					</article>
				);
			})}
		</div>
	</main>
</SiteLayout>

<style>
.category-page {
	max-width: var(--content-max-width);
	margin: 0 auto;
	padding: 20px var(--header-padding-x) 60px;
}

.category-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 16px;
}

.category-card {
	aspect-ratio: 1 / 1;
}

.category-card-link {
	display: flex;
	flex-direction: column;
	height: 100%;
	text-decoration: none;
	background: rgba(0, 0, 0, 0.75);
	border: 1px solid var(--accent);
	overflow: hidden;
}

.category-card-link:hover {
	border-color: var(--accent);
	opacity: 1;
}

/* Image or excerpt area — top 50% of card */
.category-card-image {
	width: 100%;
	height: 50%;
	overflow: hidden;
	background: var(--accent-ghost);
}

.category-card-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.category-card-excerpt {
	width: 100%;
	height: 50%;
	padding: 14px;
	overflow: hidden;
	background: var(--accent-ghost);
	display: flex;
	align-items: flex-start;
}

.category-card-excerpt p {
	font-size: 11px;
	color: rgba(28, 235, 244, 0.5);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	line-height: 1.5;
	margin: 0;
	display: -webkit-box;
	-webkit-line-clamp: 5;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

/* Card body */
.category-card-body {
	padding: 14px;
	flex: 1;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

.category-card-date {
	font-size: 11px;
	color: var(--text-muted);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	margin-bottom: 6px;
}

.category-card-title {
	font-size: 14px;
	font-weight: var(--font-weight-body);
	color: var(--accent);
	margin: 0;
	line-height: 1.3;
	font-family: var(--font-body);
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.category-card-stats {
	display: flex;
	gap: 10px;
	align-items: center;
	font-size: 10px;
	color: rgba(28, 235, 244, 0.45);
	margin-top: auto;
	padding-top: 8px;
}

.category-stat {
	display: flex;
	align-items: center;
	gap: 3px;
}

.category-stat svg {
	color: rgba(28, 235, 244, 0.45);
}

.category-card-read-more {
	display: block;
	font-size: 10px;
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	color: var(--accent-dim);
	margin-top: 4px;
	letter-spacing: 0.03em;
	transition: opacity 0.2s;
}

@media (max-width: 768px) {
	.category-grid {
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
	}
}

@media (max-width: 480px) {
	.category-grid {
		grid-template-columns: 1fr;
	}
}
</style>
