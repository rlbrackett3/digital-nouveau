---
// Category filter page — unified 3-column square card grid
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', () => true);

// Get all unique categories from posts
const categorySet = new Set();
allPosts.forEach(post => {
	if (post.data.categories) {
		post.data.categories.forEach(cat => categorySet.add(cat));
	}
});

const categories = Array.from(categorySet);

export async function getStaticPaths() {
	const posts = await getCollection('blog', () => true);
	const cats = new Set();
	posts.forEach(p => { if (p.data.categories) p.data.categories.forEach(c => cats.add(c)); });
	return Array.from(cats).map(cat => ({ params: { category: cat } }));
}

const category = Astro.params.category;
const filteredPosts = allPosts
	.filter(post => post.data.categories && post.data.categories.includes(category))
	.sort((a, b) => {
		const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
		const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
		return dateB - dateA;
	});
---

<SiteLayout title={category}>
	<main class="category-page">
		<div class="category-grid">
			{filteredPosts.map(post => {
				const dateStr = post.data.pubDate
					? new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
					: '';
				return (
					<article class="category-card">
						<a href={`/blog/${post.id}`} class="category-card-link">
							{post.data.image && (
								<div class="category-card-image">
									<img src={post.data.image} alt={post.data.title} loading="lazy" />
								</div>
							)}
							<div class="category-card-body">
								<time class="category-card-date">{dateStr}</time>
								<h2 class="category-card-title">{post.data.title}</h2>
							</div>
						</a>
					</article>
				);
			})}
		</div>
	</main>
</SiteLayout>

<style>
.category-page {
	max-width: var(--content-max-width);
	margin: 0 auto;
	padding: 20px var(--header-padding-x) 60px;
}

.category-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 10px;
}

.category-card {
	aspect-ratio: 1 / 1;
}

.category-card-link {
	display: flex;
	flex-direction: column;
	height: 100%;
	text-decoration: none;
	background: transparent;
	border: 1px solid var(--accent-subtle);
	overflow: hidden;
	transition: none;
}

.category-card-link:hover {
	border-color: var(--accent);
}

.category-card-image {
	width: 100%;
	height: 50%;
	overflow: hidden;
	background: var(--accent-ghost);
}

.category-card-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.category-card-body {
	padding: 10px;
	flex: 1;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

.category-card-date {
	font-size: 11px;
	color: var(--text-muted);
	font-family: var(--font-body);
	font-weight: var(--font-weight-body);
	margin-bottom: 8px;
}

.category-card-title {
	font-size: 14px;
	font-weight: var(--font-weight-body);
	color: var(--accent);
	margin: 0;
	line-height: 1.3;
	font-family: var(--font-body);
}

@media (max-width: 768px) {
	.category-grid {
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
	}
}

@media (max-width: 480px) {
	.category-grid {
		grid-template-columns: 1fr;
	}
}
</style>
