				<li><em>Tao Te Ching</em> — Ursula K. LeGuin</li>
				<li><em>The Watercourse Way</em> — Alan Watts</li>
			</ul>
		</section>

		<section>
			<h2>📖 Recent Book Club Posts</h2>
			<ul>
				{skyfiPosts.map(post => (
					<li>
						<a href={`/blog/${post.slug}`}>
							<strong>{post.data.title}</strong>
							<span class="post-date">
								{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	</main>
</SiteLayout>
