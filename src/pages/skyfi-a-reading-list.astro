---
// SkyFi reading list page
import SiteLayout from '@/components/SiteLayout.astro';
import { SITE_TITLE } from '@/consts';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const skyfiPosts = allPosts
	.filter(post => post.data.categories.includes('skyfi'))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<SiteLayout title="SkyFi :: A Reading List | {SITE_TITLE}">
	<head>
		<title>SkyFi :: A Reading List | {SITE_TITLE}</title>
	</head>

	<main class="skyfi-page">
		<h1>📚 SkyFi :: Reading List</h1>

		<section>
			<h2>🏢 Club Overview</h2>
			<ul>
				<li><strong>Name:</strong> SkyFi</li>
				<li><strong>Focus:</strong> Primarily science fiction, blended with philosophy, music, horror, surrealism, and post-modern literature.</li>
				<li><strong>Demographics:</strong> NYC-based group, predominantly architects.</li>
				<li><strong>Purpose:</strong> Collaborative book club with spinoff explorations and curated reading radars.</li>
			</ul>
		</section>

		<section>
			<h2>📅 Currently Reading (October 2020)</h2>
			<ul>
				<li>📖 <strong>Pseudo Fiction:</strong> <em>Staying with the Trouble: Making Kin in the Chthulucene</em> by Donna Haraway</li>
				<li>🎬 <strong>Watching:</strong> <em>Alien 3</em></li>
			</ul>
		</section>

		<section>
			<h2>📜 Chronological Club Reads</h2>
			<ul>
				<li><em>Ubik</em> — Philip K. Dick</li>
