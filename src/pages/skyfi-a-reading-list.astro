	<style>
		.skyfi-page {
			max-width: var(--post-max-width);
			margin: 0 auto;
			padding: 1.5rem var(--header-padding-x);
		}

		.skyfi-intro {
			font-size: 1rem;
			font-weight: 300;
			line-height: 1.6;
			color: var(--text-primary);
			margin-bottom: 2rem;
			padding-top: 1rem;
		}

		.skyfi-section {
			margin-bottom: 2rem;
		}

		.skyfi-section h1 {
			font-size: 1.1rem;
			font-weight: 300;
			line-height: 1.4;
			color: var(--text-primary);
			margin: 0.5rem 0;
		}

		.skyfi-section p {
			font-size: 0.95rem;
			font-weight: 300;
			line-height: 1.6;
			color: var(--text-primary);
			margin: 0.25rem 0;
		}

		.skyfi-page > h1 {
			font-size: 1.1rem;
			font-weight: 300;
			line-height: 1.4;
			color: var(--text-primary);
			margin: 1.5rem 0 0.5rem 0;
		}

		.skyfi-page a {
			color: var(--text-link);
			text-decoration: none;
		}

		.skyfi-page a:hover {
			color: var(--text-link-hover);
		}

		@media (max-width: 768px) {
			.skyfi-page {
				padding: 1rem var(--header-padding-x);
			}
		}
	</style>
</SiteLayout>
