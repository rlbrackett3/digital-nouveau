---
// Updated blog index page - Wix-inspired light theme
import SiteLayout from '@/components/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '@/consts';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.map(post => {
		const words = (post.body || '').trim().split(/\s+/).filter(Boolean).length;
		return { ...post, readTime: Math.max(1, Math.ceil(words / 200)) };
	});
---

<SiteLayout title={"Blog Archive | " + SITE_TITLE}>
	<head>
		<title>Blog Archive | {SITE_TITLE}</title>
	</head>

	<main class="blog-page">
		<div class="section-header">
			<h1>Blog Archive</h1>
			<p>All posts, newest first.</p>
		</div>

		<div class="post-list">
			{sortedPosts.map(post => (
				<article class="post-card">
					{post.data.image && (
						<a href={`/blog/${post.id}`} class="post-thumbnail-link">
							<img
								src={post.data.image}
								alt={post.data.title}
								class="post-thumbnail"
								loading="lazy"
								width="240"
								height="180"
							/>
						</a>
					)}
					<div class="post-content">
						<div class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
							{post.readTime && (
								<span class="read-time">· {post.readTime} min read</span>
							)}
						</div>
						<h2>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
						</h2>
						<p>{post.data.description}</p>
						{post.data.categories && post.data.categories.length > 0 && (
							<div class="post-categories">
								{post.data.categories.map(cat => (
									<a href={`/category/${cat}`} class="category-tag">{cat}</a>
								))}
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</main>

	<style>
		.blog-page {
			max-width: 980px;
			margin: 0 auto;
			padding: 2rem 2rem;
		}

		@media (max-width: 768px) {
			.blog-page {
				padding: 1.5rem 1rem;
			}
		}

		/* Category filter bar */
		.category-filter {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			flex-wrap: wrap;
			padding: 0.75rem 0;
			margin-bottom: 1.5rem;
			border-top: 1px solid var(--border);
			border-bottom: 1px solid var(--border);
		}

		.filter-label {
			font-size: 0.7rem;
			color: var(--text-muted);
			text-transform: lowercase;
			letter-spacing: 0.05em;
			margin-right: 0.25rem;
		}

		.filter-link {
			color: var(--text-secondary);
			text-decoration: none;
			font-size: 0.8rem;
			font-weight: 400;
			transition: color 0.2s;
		}

		.filter-link:hover {
			color: var(--accent);
		}

		.filter-sep {
			font-size: 0.7rem;
			color: var(--text-muted);
			user-select: none;
		}

		.post-list {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		.post-card {
			display: flex;
			gap: 1.5rem;
			padding: 1.5rem;
			background: #fff;
			border: 1px solid var(--border);
			border-radius: 4px;
			transition: box-shadow 0.2s;
		}

		.post-card:hover {
			box-shadow: 0 2px 8px rgba(0,0,0,0.06);
		}

		.post-thumbnail-link {
			flex-shrink: 0;
			width: 240px;
			height: 180px;
			overflow: hidden;
			border-radius: 3px;
		}

		.post-thumbnail {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.3s ease;
		}

		.post-thumbnail-link:hover .post-thumbnail {
			transform: scale(1.05);
		}

		.post-content {
			flex: 1;
			min-width: 0;
		}

		.post-content h2 {
			margin: 0.3rem 0;
			font-size: 1.3rem;
			font-weight: 500;
			line-height: 1.3;
		}

		.post-content h2 a {
			color: var(--text-primary);
			text-decoration: none;
		}

		.post-content h2 a:hover {
			color: var(--accent);
		}

		.post-content p {
			color: var(--text-secondary);
			font-size: 0.9rem;
			line-height: 1.6;
			margin: 0.5rem 0;
		}

		@media (max-width: 600px) {
			.post-card {
				flex-direction: column;
				padding: 1rem;
			}
			.post-thumbnail-link {
				width: 100%;
				height: 200px;
			}
		}
	</style>
</SiteLayout>