---
// About page - dark theme matching Wix aesthetic
import SiteLayout from '@/components/SiteLayout.astro';
import { SITE_TITLE } from '@/consts';
---

<SiteLayout title="About | {SITE_TITLE}">
	<head>
		<title>About | {SITE_TITLE}</title>
	</head>

	<main class="about-page">
		<div class="section-header">
			<h1>&gt; about ~</h1>
		</div>

		<p>Digital Nouveau is a feed of design, computation, and fabrication work by Robert Lee Brackett. These musings are happening behind the scenes of Robert's design work with Miscellaneous Projects and teaching as a Professor of Architecture at Pratt Institute in New York.</p>

		<h2>Miscellaneous Projects</h2>
		<p>Architecture and design studio focused on computational design, fabrication, and research.</p>

		<h2>Pratt Institute</h2>
		<p>Professor of Architecture, teaching design studios and computational design courses.</p>

		<h2>SkyFi</h2>
		<p>A NYC-based book club exploring science fiction, philosophy, and speculative literature.</p>

		<h2>Connect</h2>
		<ul>
			<li><a href="https://www.mindfuldrawing.art">Mindful Drawing</a></li>
			<li><a href="https://www.multiprojects.com">Miscellaneous Projects</a></li>
			<li><a href="https://www.instagram.com/rooksisfun">@rooksisfun</a></li>
		</ul>
	</main>

	<style>
		.about-page {
			max-width: var(--post-max-width);
			margin: 2rem auto;
			padding: 0 var(--header-padding-x);
		}

		.section-header {
			margin-bottom: 1.5rem;
			padding-top: 1rem;
		}

		.section-header h1 {
			margin: 0;
			font-size: 1.75rem;
			font-weight: 300;
			color: var(--accent);
		}

		.about-page h2 {
			font-size: 1.35rem;
			color: var(--text-primary);
			margin-top: 2rem;
			margin-bottom: 0.5rem;
			font-weight: 300;
		}

		.about-page p {
			color: var(--text-secondary);
			line-height: 1.8;
			margin-bottom: 1.5rem;
		}

		.about-page ul {
			color: var(--text-secondary);
			padding-left: 1.5em;
		}

		.about-page li {
			margin-bottom: 0.5rem;
		}

		.about-page a {
			color: var(--text-link);
		}

		.about-page a:hover {
			color: var(--text-link-hover);
		}

		@media (max-width: 768px) {
			.about-page {
				padding: 0 var(--header-padding-x);
			}
		}
	</style>
</SiteLayout>
