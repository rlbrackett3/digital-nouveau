---
// Portfolio page — dark theme, real content from PORTFOLIO_NOTES.md
import SiteLayout from '@/components/SiteLayout.astro';
import { SITE_TITLE } from '@/consts';

interface Project {
	title: string;
	date: string;
	description: string;
	slug?: string;
	anchor?: string;
}

const architecture: Project[] = [
	{
		title: 'Aesthetic Tuning :: Colony',
		date: 'Oct 2019',
		description: 'Collage-drawing experiments for Art Prison Competition 2017. Procedural Rollage technique superimposing images to de-contextualize content, exploring "Aesthetic Drivers" as convergences of Organization::Qualities::Tectonics — viscous, deep, phasing scape.',
		slug: 'aesthetic-tuning-colony',
	},
	{
		title: 'THICK SPACE :: Mapping Ambiguous Territories',
		date: 'Aug 2019',
		description: 'Studio prompt for ARCH 201 :: Intermediate Design I at Pratt (Fall 2019). Focus on plan and mat building typology — walls as mediators and thresholds, destabilizing devices of interface and transition.',
		slug: 'thick-space-mapping-ambiguous-territories',
	},
	{
		title: 'Learning to Design @ Home :: Drawing and Modeling',
		date: 'Jul 2020',
		description: 'Fall \'19 / Spring \'20 Pratt course for NYC high school students, co-taught with Olivia Vien. Analog drawing and modeling during pandemic — 3-part video series translating 2D abstract drawing to 3D form.',
		slug: 'learning-to-design-home-drawing-and-modeling',
	},
	{
		title: 'Representational Analysis :: Decomposition Drawing & Video',
		date: 'Jan 2020',
		description: 'Drawing and video as analytical tools for architectural representation. Exploring decomposition as a method for understanding spatial and formal relationships.',
		slug: 'representational-analysis-decomposition-drawing-video',
	},
	{
		title: 'Comics :: Architectural Narratives',
		date: 'Mar 2020',
		description: 'Collaborative project with Prof. Sacha Frey and Pratt first-year architecture students. 15+ semesters of co-teaching using comic format as visual/writing platform. Presented at OU\'s Schools of Thought: Rethinking Architecture Pedagogy.',
		slug: 'comics-architectural-narratives',
	},
	{
		title: '[Trans-] FICTION 2020 :: Comics Beyond Fiction',
		date: 'Sep 2020',
		description: 'Volume 6 of [Trans-] FICTION journal, continued comics collaboration with Sacha Frey. Examines architecture as creative production of fiction into reality. Journal edited by Ashley Simone through University of Arizona.',
		slug: 'comics-beyond-fiction-trans-fiction-2020',
	},
];

const fabrication: Project[] = [
	{
		title: 'Hyphae Simulations (mk1, mk2, mk3)',
		date: 'Aug 2019',
		description: 'Maya nParticles and dynamics simulating mycelium/filament growth. Three versions exploring increasingly complex rhizomatic networks — particles cross, entangle, and merge into rhizomatic connections within organizational voids.',
		slug: 'hyphae-simulations-mk1',
	},
	{
		title: 'Landforms - Craggs',
		date: 'May 2014',
		description: 'Maya nParticles and dynamic fields for turbulent landscape deformation. Particle grid linked by woven spring system — explicit control vs. emergent behavior. Goal: 3D printed landscape with embedded fossil objects.',
		slug: 'landforms-craggs',
	},
	{
		title: 'Luna Moth Cocooning Ring',
		date: 'Sep 2014',
		description: 'Custom ring design transforming Luna Moth pendant geometry into a cocooning life-cycle form. Insect symmetry compressed into knot. Mexican fire opal gem setting, polished sterling silver. 3D printed prototypes.',
		slug: 'luna-moth-cocooning-ring-prototype-v01',
	},
	{
		title: 'Cocooning Ring Prototypes',
		date: 'Oct 2014',
		description: 'Resin and Nylon prototype iterations comparing form and detail, opal location and fit testing. Design refinement toward slimmer, more elegant form with tighter opening for flexible fit.',
		slug: 'cocooning-ring-prototypes',
	},
	{
		title: 'Contouring - Plywood Landscapes',
		date: 'Jun 2015',
		description: 'Laser-cut layered plywood topographic studies exploring spatial contour through physical fabrication and material stacking.',
		slug: 'contouring-plywood-landscapes',
	},
	{
		title: 'Ruicci 2.0 - A New Seat',
		date: 'May 2015',
		description: 'Seating design exploring form, structure, and materiality through computational fabrication.',
		slug: 'ruicci-2-0-a-new-seat',
	},
	{
		title: 'TicToc - A Gnarly Clock',
		date: 'Jan 2016',
		description: 'Timepiece design blending computational form generation with functional object design.',
		slug: 'tic-tock-a-gnarly-clock',
	},
	{
		title: 'Concept Sketches for a Lighthouse',
		date: 'May 2015',
		description: 'Concept sketches exploring lighthouse typology and coastal form generation.',
		slug: 'concept-sketches-for-a-lighthouse',
	},
];

const research: Project[] = [
	{
		title: 'Organisms :: Hypno-Topography',
		date: 'Nov 2019',
		description: 'Procedural topography generation from collage inputs. Flowers from Serifos island (Greece) as visual input, rollage technique creating height-field inputs for Rhino. Territories with coastal boundaries, oozing islands, dramatic peaks.',
		slug: 'organism-hypno-topography',
	},
	{
		title: 'Aesthetic Tuning Methodology',
		date: 'Ongoing',
		description: 'Core R&D concept: procedural collage-drawing for design ideation. Strategies to resolve conflict between influence and invention without direct copying. Organization::Qualities::Tectonics framework for generating Aesthetic Drivers.',
	},
	{
		title: 'SubTerranea[N]',
		date: 'Jan 2015',
		description: 'Subterranean space mapping and underground territory exploration.',
		slug: 'subterranean',
	},
	{
		title: 'Traveller :: Emergence',
		date: 'Dec 2019',
		description: 'Exploring emergent form through procedural and generative processes.',
		slug: 'traveller-emergence',
	},
	{
		title: 'Site Impressions :: Video Collage',
		date: 'Oct 2019',
		description: 'Video-based site exploration through collage and procedural assembly.',
		slug: 'site-impressions-video-collage',
	},
	{
		title: 'A Texas Thistle',
		date: 'Aug 2019',
		description: 'Natural form studies and botanical observation as design input.',
		slug: 'a-texas-thistle',
	},
];

const teaching: Project[] = [
	{
		title: 'Comics :: Architectural Narratives',
		date: 'Mar 2020',
		description: 'Also filed under Architecture & Design. 15 semesters of paired teaching at Pratt Arch100 Studio — comic format bridges visual communication of architecture with literary communication, decolonizing both specializations.',
		anchor: '#architecture',
	},
	{
		title: 'Learning to Design @ Home',
		date: 'Jul 2020',
		description: 'Also filed under Architecture & Design. Pratt K-12 program focused on analog design pedagogy during pandemic — drawing and modeling translated to physical form.',
		anchor: '#architecture',
	},
	{
		title: 'Representational Analysis :: Decomposition Drawing & Video',
		date: 'Jan 2020',
		description: 'Teaching and research intersection. Drawing and video as both pedagogical and analytical tools for architectural practice. Also filed under Architecture & Design.',
		anchor: '#architecture',
	},
];

interface Section {
	title: string;
	id: string;
	projects: Project[];
}

const sections: Section[] = [
	{ title: 'Architecture & Design', id: 'architecture', projects: architecture },
	{ title: 'Fabrication & Making', id: 'fabrication', projects: fabrication },
	{ title: 'Research & Development', id: 'research', projects: research },
	{ title: 'Teaching & Pedagogy', id: 'teaching', projects: teaching },
];
---

<SiteLayout title="Portfolio">

	<main class="portfolio-page">
		<div class="section-header">
			<h1>&gt; portfolio ~</h1>
			<p>A collection of design, fabrication, and research projects.</p>
		</div>

		{sections.map(section => (
			<section class="portfolio-section" id={section.id}>
				<h2>{section.title}</h2>
				<div class="project-grid">
					{section.projects.map(project => {
						// Cross-ref items link to the architecture section anchor
						const href = project.anchor
							? project.anchor
							: project.slug
								? `/post/${project.slug}`
								: undefined;
						const isLinkable = !!href;
						return (
							<article class={`project-card${isLinkable ? '' : ' no-link'}`}>
								{isLinkable ? (
									<a href={href} class="project-link">
										<div class="project-body">
											<span class="project-date">{project.date}</span>
											<h3 class="project-title">{project.title}</h3>
											<p class="project-desc">{project.description}</p>
										</div>
										<span class="project-arrow">&rarr;</span>
									</a>
								) : (
									<div class="project-link project-link--static">
										<div class="project-body">
											<span class="project-date">{project.date}</span>
											<h3 class="project-title">{project.title}</h3>
											<p class="project-desc">{project.description}</p>
										</div>
									</div>
								)}
							</article>
						);
					})}
				</div>
			</section>
		))}
	</main>

	<style>
		.portfolio-page {
			max-width: var(--post-max-width);
			margin: 2rem auto;
			padding: 0 var(--header-padding-x);
		}

		.section-header {
			margin-bottom: 2rem;
			padding-top: 1rem;
		}

		.section-header h1 {
			margin: 0 0 0.25rem 0;
			font-size: 1.75rem;
			font-weight: 100;
			color: var(--accent);
		}

		.section-header p {
			font-size: 0.9rem;
			color: var(--text-muted);
		}

		.portfolio-section {
			margin-bottom: 3rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid var(--border);
		}

		.portfolio-section:last-child {
			border-bottom: none;
			margin-bottom: 1rem;
		}

		.portfolio-section h2 {
			font-size: 1.35rem;
			color: var(--text-primary);
			margin-top: 0;
			margin-bottom: 1.25rem;
			font-weight: 100;
			font-family: var(--font-body);
		}

		.project-grid {
			display: grid;
			gap: 16px;
		}

		.project-card {
			border: 1px solid var(--border);
			background: rgba(0, 0, 0, 0.5);
			transition: border-color 0.2s;
		}

		.project-card:hover {
			border-color: var(--accent);
		}

		.project-card.no-link {
			border-style: dashed;
		}

		.project-link {
			text-decoration: none;
			display: flex;
			align-items: flex-start;
			gap: 1rem;
			padding: 1.25rem;
			cursor: pointer;
		}

		.project-link--static {
			cursor: default;
		}

		.project-body {
			flex: 1;
			min-width: 0;
		}

		.project-date {
			font-size: 11px;
			color: var(--text-muted);
			font-family: var(--font-body);
			font-weight: var(--font-weight-body);
			display: block;
			margin-bottom: 0.25rem;
		}

		.project-title {
			font-size: 1rem;
			color: var(--accent);
			margin: 0 0 0.5rem 0;
			line-height: 1.3;
			font-family: var(--font-body);
			font-weight: var(--font-weight-body);
		}

		.project-desc {
			font-size: 0.85rem;
			color: var(--text-secondary);
			line-height: 1.6;
			margin: 0;
			font-family: var(--font-body);
			font-weight: var(--font-weight-body);
		}

		.project-arrow {
			color: var(--accent-dim);
			font-size: 1.2rem;
			opacity: 0;
			transition: opacity 0.2s, transform 0.2s;
			align-self: center;
		}

		.project-card:hover .project-arrow {
			opacity: 1;
			transform: translateX(4px);
		}

		/* Two-column grid on wider screens */
		@media (min-width: 768px) {
			.project-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.project-desc {
				-webkit-line-clamp: 3;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
		}

		@media (max-width: 767px) {
			.portfolio-page {
				padding: 0 var(--header-padding-x);
			}

			.project-link {
				padding: 1rem;
				gap: 0.75rem;
			}

			.project-title {
				font-size: 0.95rem;
			}

			.project-desc {
				font-size: 0.8rem;
			}
		}
	</style>
</SiteLayout>
