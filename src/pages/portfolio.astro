---
// Portfolio page - dark theme matching Wix aesthetic
import SiteLayout from '@/components/SiteLayout.astro';
import { SITE_TITLE } from '@/consts';
---

<SiteLayout title="Portfolio | {SITE_TITLE}">
	<head>
		<title>Portfolio | {SITE_TITLE}</title>
	</head>

	<main class="portfolio-page">
		<div class="section-header">
			<h1>&gt; portfolio ~</h1>
			<p>A collection of design, fabrication, and research projects.</p>
		</div>

		<section>
			<h2>Architecture &amp; Design</h2>
			<p>Architectural design work from studio practice and professional projects.</p>
		</section>

		<section>
			<h2>Fabrication &amp; Making</h2>
			<p>Laser cutting, 3D printing, and physical prototyping projects.</p>
		</section>

		<section>
			<h2>Research &amp; Development</h2>
			<p>Computational design research and material exploration.</p>
		</section>

		<section>
			<h2>Teaching &amp; Pedagogy</h2>
			<p>Course materials, studio reviews, and educational resources.</p>
		</section>
	</main>

	<style>
		.portfolio-page {
			max-width: var(--post-max-width);
			margin: 2rem auto;
			padding: 0 var(--header-padding-x);
		}

		.section-header {
			margin-bottom: 1.5rem;
			padding-top: 1rem;
		}

		.section-header h1 {
			margin: 0 0 0.25rem 0;
			font-size: 1.75rem;
			font-weight: 100;
			color: var(--accent);
		}

		.section-header p {
			font-size: 0.9rem;
			color: var(--text-muted);
		}

		.portfolio-page section {
			margin-bottom: 2rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid var(--border);
		}

		.portfolio-page section:last-child {
			border-bottom: none;
		}

		.portfolio-page h2 {
			font-size: 1.35rem;
			color: var(--text-primary);
			margin-top: 0;
			margin-bottom: 0.5rem;
			font-weight: 100;
		}

		.portfolio-page p {
			color: var(--text-secondary);
			line-height: 1.8;
			margin-bottom: 0;
		}

		@media (max-width: 768px) {
			.portfolio-page {
				padding: 0 var(--header-padding-x);
			}
		}
	</style>
</SiteLayout>
